@page
@model CambioDeDomicilio.Dashboard.Pages.EstadisticasModel
@using System.Text.Json
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Estadísticas — CambioDeDomicilio</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <div class="brand">
            <img src="~/images/logo-municipalidad.png" alt="Municipalidad de Valparaíso" class="brand-logo" />
            <span>
                CambioDeDomicilio
                <small>Municipalidad de Valparaíso</small>
                <small>Estadísticas</small>
            </span>
        </div>
        <nav class="app-nav">
            <button type="button" id="btn-guia-global" class="btn-guia-accion" title="Cómo usar el sistema (Guía interactiva)" data-tooltip="Simulador interactivo con flecha explicativa que te enseña paso a paso cómo usar el sistema">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                <span>Cómo usar el sistema</span>
            </button>
            <div class="nav-group">
                <a asp-page="/Index"><partial name="_NavIcon" model="@("back")" /><span>Volver a Casos</span></a>
                <a asp-page="/Comunas"><partial name="_NavIcon" model="@("map")" /><span>Comunas</span></a>
                <a asp-page="/Discarded"><partial name="_NavIcon" model="@("discarded")" /><span>Descartados</span></a>
            </div>
        </nav>
    </header>
    <div class="app-subnav">
        <div class="app-subnav-main">
            <span class="app-subnav-label">Sistemas</span>
            <a asp-page="/Index" class="nav-casos"><partial name="_NavIcon" model="@("home")" /><span>Cambio de Domicilio</span></a>
            <a asp-page="/F8" class="nav-f8"><partial name="_NavIcon" model="@("f8")" /><span>F8</span></a>
            <a asp-page="/SubidasASistema" class="nav-subidas"><partial name="_NavIcon" model="@("upload")" /><span>Subidas a Sistema</span></a>
            <a asp-page="/SinCarpetas" class="nav-sin-carpetas"><partial name="_NavIcon" model="@("sin-carpetas")" /><span>Sin Carpetas</span></a>
            <a asp-page="/Caja" class="nav-caja"><partial name="_NavIcon" model="@("caja")" /><span>Caja</span></a>
            <a asp-page="/Estadisticas" class="nav-estadisticas active"><partial name="_NavIcon" model="@("stats")" /><span>Estadísticas</span></a>
        </div>
        <div class="app-subnav-docs">
            <span class="app-subnav-label">Documentos</span>
            <a asp-page="/Sector" asp-route-sector="Archivo" class="nav-pdf-archivo" title="Generar listado para Archivo">
                <partial name="_NavIcon" model="@("pdf")" /><span>PDF Archivo</span>
            </a>
            <a asp-page="/Sector" asp-route-sector="Oficina43" class="nav-pdf-oficina43" title="Generar listado para Oficina 43">
                <partial name="_NavIcon" model="@("pdf")" /><span>PDF Oficina 43</span>
            </a>
        </div>
    </div>

    <main>
        <div class="stats-grid">
            <div class="stats-card">
                <h2>Casos por estado</h2>
                <canvas id="chart-status"></canvas>
            </div>
            <div class="stats-card">
                <h2>Ingresos por semana</h2>
                <canvas id="chart-weekly"></canvas>
            </div>
            <div class="stats-card">
                <h2>Top comunas por volumen</h2>
                <canvas id="chart-comunas"></canvas>
            </div>
            <div class="stats-card">
                <h2>Tiempo promedio de confirmación</h2>
                @if (Model.Turnaround.HasData)
                {
                    <canvas id="chart-turnaround"></canvas>
                }
                else
                {
                    <p class="stats-nodata">Todavía no hay casos confirmados.</p>
                }
            </div>
            <div class="stats-card">
                <h2>Dispersión de tiempos de confirmación</h2>
                @if (Model.Turnaround.HasData)
                {
                    <canvas id="chart-turnaround-scatter"></canvas>
                }
                else
                {
                    <p class="stats-nodata">Todavía no hay casos confirmados.</p>
                }
            </div>
            <div class="stats-card">
                <h2>Sector: Archivo vs Oficina 43</h2>
                <canvas id="chart-sector"></canvas>
            </div>
            <div class="stats-card">
                <h2>F8: plazo (15 días hábiles)</h2>
                <canvas id="chart-f8-deadline"></canvas>
            </div>
            <div class="stats-card">
                <h2>F8: PDFs generados</h2>
                <canvas id="chart-f8-pdf"></canvas>
            </div>
            <div class="stats-card stats-card-wide">
                <h2>Correos descartados por motivo</h2>
                <canvas id="chart-discarded"></canvas>
            </div>
        </div>
    </main>

    <script id="stats-data" type="application/json">
        @* Server-generated JSON, not raw user input: built from StatisticsService aggregates (case counts,
           totals) computed server-side. JsonSerializer's default encoder HTML-escapes '<', '>', '&' and
           quotes, so even the "discarded reason" strings (which loosely echo an external sender's email
           domain) cannot break out of this <script> tag. Consuming code (estadisticas.js) only feeds this
           data into Chart.js, which renders labels via canvas fillText, not innerHTML. *@
        @Html.Raw(JsonSerializer.Serialize(new
        {
            status = Model.StatusCounts,
            weekly = Model.WeeklyIntake,
            comunas = Model.TopComunas,
            turnaround = Model.Turnaround,
            turnaroundDistribution = Model.TurnaroundDistribution,
            sector = Model.SectorDistribution,
            f8Deadline = Model.F8DeadlineBacklog,
            f8Pdf = Model.F8PdfStatus,
            discarded = Model.DiscardedByReason
        }, new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase }))
    </script>
    <script src="~/js/vendor/chart.umd.js"></script>
    <script src="~/js/estadisticas.js" asp-append-version="true"></script>
    <script src="~/js/scroll-preserve.js" asp-append-version="true"></script>
    <script src="~/js/system-tour.js" asp-append-version="true"></script>
    <partial name="_AuthorFooter" />
</body>
</html>
