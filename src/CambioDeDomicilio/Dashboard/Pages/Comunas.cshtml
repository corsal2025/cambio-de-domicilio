@page
@model CambioDeDomicilio.Dashboard.Pages.ComunasModel
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Directorio de comunas — CambioDeDomicilio</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <div class="brand">
            <img src="~/images/logo-municipalidad.png" alt="Municipalidad de Valparaíso" class="brand-logo" />
            <span>
                CambioDeDomicilio
                <small>Municipalidad de Valparaíso</small>
                <small>Directorio de comunas</small>
            </span>
        </div>
        <nav class="app-nav">
            <div class="nav-group">
                <a asp-page="/Index"><partial name="_NavIcon" model="@("back")" /><span>Volver a Casos</span></a>
                <a asp-page="/Comunas" class="active"><partial name="_NavIcon" model="@("map")" /><span>Comunas</span></a>
                <a asp-page="/Discarded"><partial name="_NavIcon" model="@("discarded")" /><span>Descartados</span></a>
            </div>
        </nav>
    </header>
    <div class="app-subnav">
        <div class="app-subnav-main">
            <span class="app-subnav-label">Sistemas</span>
            <a asp-page="/Index" class="nav-casos"><partial name="_NavIcon" model="@("home")" /><span>Cambio de Domicilio</span></a>
            <a asp-page="/F8" class="nav-f8"><partial name="_NavIcon" model="@("f8")" /><span>F8</span></a>
            <a asp-page="/SubidasASistema" class="nav-subidas"><partial name="_NavIcon" model="@("upload")" /><span>Subidas a Sistema</span></a>
            <a asp-page="/SinCarpetas" class="nav-sin-carpetas"><partial name="_NavIcon" model="@("sin-carpetas")" /><span>Sin Carpetas</span></a>
            <a asp-page="/Caja" class="nav-caja"><partial name="_NavIcon" model="@("caja")" /><span>Caja</span></a>
            <a asp-page="/Estadisticas" class="nav-estadisticas"><partial name="_NavIcon" model="@("stats")" /><span>Estadísticas</span></a>
        </div>
        <div class="app-subnav-docs">
            <span class="app-subnav-label">Documentos</span>
            <a asp-page="/Sector" asp-route-sector="Archivo" class="nav-pdf-archivo" title="Generar listado para Archivo">
                <partial name="_NavIcon" model="@("pdf")" /><span>PDF Archivo</span>
            </a>
            <a asp-page="/Sector" asp-route-sector="Oficina43" class="nav-pdf-oficina43" title="Generar listado para Oficina 43">
                <partial name="_NavIcon" model="@("pdf")" /><span>PDF Oficina 43</span>
            </a>
            <button type="button" id="btn-guia-global" class="btn-guia-accion" title="Cómo usar el sistema (Guía interactiva)" data-tooltip="Simulador interactivo con flecha explicativa que te enseña paso a paso cómo usar el sistema">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                <span>Cómo usar el sistema</span>
            </button>
        </div>
    </div>

    <main>
        @if (Model.Message is not null)
        {
            <p class="message-banner @(Model.MessageIsError ? "message-error" : "")">@Model.Message</p>
        }

        <div class="card card-form">
            <form method="post" asp-page-handler="AddContact" class="manual-entry-form">
                <div class="form-group">
                    <label class="form-label" for="new-comuna">Comuna</label>
                    <input type="text" name="comuna" id="new-comuna" required placeholder="ej: Villa Alemana"
                           class="form-control" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="new-domain">Dominio del correo</label>
                    <input type="text" name="domain" id="new-domain" required placeholder="ej: villaalemana.cl"
                           class="form-control" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="new-email">Correo de contacto</label>
                    <input type="email" name="email" id="new-email" required placeholder="ej: contacto@villaalemana.cl"
                           class="form-control" style="min-width:260px;" />
                </div>
                <button type="submit" class="btn-primary">Agregar comuna</button>
            </form>
        </div>

        <div class="card">
            <table class="cases">
                <thead>
                    <tr>
                        <th>Comuna</th>
                        <th>Dominio</th>
                        <th>Correo de contacto</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var contact in Model.Contacts)
                {
                    var rowId = $"{contact.Comuna}-{contact.Domain}".Replace(" ", "-").Replace(".", "-");
                    <tr>
                        <td>@contact.Comuna</td>
                        <td>
                            <input type="text" name="newDomain" form="edit-@rowId" value="@contact.Domain" required
                                   style="width:140px; border:1px solid var(--color-border); border-radius:4px; padding:4px 6px; font-size:0.85rem;" />
                        </td>
                        <td>
                            <input type="email" name="email" form="edit-@rowId" value="@contact.ContactEmail" required
                                   style="width:100%; min-width:240px; border:1px solid var(--color-border); border-radius:4px; padding:4px 6px; font-size:0.85rem;" />
                        </td>
                        <td style="display:flex; gap:8px;">
                            <form id="edit-@rowId" method="post" asp-page-handler="UpdateContact">
                                <input type="hidden" name="comuna" value="@contact.Comuna" />
                                <input type="hidden" name="domain" value="@contact.Domain" />
                                <button type="submit" class="btn-primary">Guardar</button>
                            </form>
                            <form method="post" asp-page-handler="DeleteContact"
                                  onsubmit="return confirm('¿Eliminar @contact.Comuna (@contact.Domain) del directorio?');">
                                <input type="hidden" name="comuna" value="@contact.Comuna" />
                                <input type="hidden" name="domain" value="@contact.Domain" />
                                <button type="submit" class="btn-danger" title="Eliminar del directorio" aria-label="Eliminar comuna">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </main>
    <script src="~/js/scroll-preserve.js" asp-append-version="true"></script>
    <partial name="_AuthorFooter" />
    <script src="~/js/system-tour.js" asp-append-version="true"></script>
</body>
</html>
