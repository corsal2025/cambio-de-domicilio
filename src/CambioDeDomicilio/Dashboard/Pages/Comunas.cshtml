@page
@model CambioDeDomicilio.Dashboard.Pages.ComunasModel
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Directorio de comunas — CambioDeDomicilio</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <div class="brand">
            <img src="~/images/logo-municipalidad.png" alt="Municipalidad de Valparaíso" class="brand-logo" />
            <span>
                CambioDeDomicilio
                <small>Municipalidad de Valparaíso</small>
                <small>Directorio de comunas</small>
            </span>
        </div>
        <nav class="app-nav">
            <div class="nav-group">
                <a asp-page="/Index">Volver a Casos</a>
                <a asp-page="/Comunas" class="active">Comunas</a>
                <a asp-page="/Discarded">Descartados</a>
            </div>
        </nav>
    </header>
    <div class="app-subnav">
        <span class="app-subnav-label">Otros sistemas</span>
        <a asp-page="/Index" class="nav-casos">Cambio de Domicilio</a>
        <a asp-page="/F8" class="nav-f8">F8</a>
        <a asp-page="/Estadisticas" class="nav-estadisticas">Estadísticas</a>
    </div>

    <main>
        @if (Model.Message is not null)
        {
            <p class="message-banner @(Model.MessageIsError ? "message-error" : "")">@Model.Message</p>
        }

        <div class="card card-form">
            <form method="post" asp-page-handler="AddContact" class="manual-entry-form">
                <div class="form-group">
                    <label class="form-label" for="new-comuna">Comuna</label>
                    <input type="text" name="comuna" id="new-comuna" required placeholder="ej: Villa Alemana"
                           class="form-control" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="new-domain">Dominio del correo</label>
                    <input type="text" name="domain" id="new-domain" required placeholder="ej: villaalemana.cl"
                           class="form-control" />
                </div>
                <div class="form-group">
                    <label class="form-label" for="new-email">Correo de contacto</label>
                    <input type="email" name="email" id="new-email" required placeholder="ej: contacto@villaalemana.cl"
                           class="form-control" style="min-width:260px;" />
                </div>
                <button type="submit" class="btn-primary">Agregar comuna</button>
            </form>
        </div>

        <div class="card">
            <table class="cases">
                <thead>
                    <tr>
                        <th>Comuna</th>
                        <th>Dominio</th>
                        <th>Correo de contacto</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var contact in Model.Contacts)
                {
                    var rowId = $"{contact.Comuna}-{contact.Domain}".Replace(" ", "-").Replace(".", "-");
                    <tr>
                        <td>@contact.Comuna</td>
                        <td>
                            <input type="text" name="newDomain" form="edit-@rowId" value="@contact.Domain" required
                                   style="width:140px; border:1px solid var(--color-border); border-radius:4px; padding:4px 6px; font-size:0.85rem;" />
                        </td>
                        <td>
                            <input type="email" name="email" form="edit-@rowId" value="@contact.ContactEmail" required
                                   style="width:100%; min-width:240px; border:1px solid var(--color-border); border-radius:4px; padding:4px 6px; font-size:0.85rem;" />
                        </td>
                        <td style="display:flex; gap:8px;">
                            <form id="edit-@rowId" method="post" asp-page-handler="UpdateContact">
                                <input type="hidden" name="comuna" value="@contact.Comuna" />
                                <input type="hidden" name="domain" value="@contact.Domain" />
                                <button type="submit" class="btn-primary">Guardar</button>
                            </form>
                            <form method="post" asp-page-handler="DeleteContact"
                                  onsubmit="return confirm('¿Eliminar @contact.Comuna (@contact.Domain) del directorio?');">
                                <input type="hidden" name="comuna" value="@contact.Comuna" />
                                <input type="hidden" name="domain" value="@contact.Domain" />
                                <button type="submit" class="btn-danger" title="Eliminar del directorio" aria-label="Eliminar comuna">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </main>
    <script src="~/js/scroll-preserve.js" asp-append-version="true"></script>
</body>
</html>
