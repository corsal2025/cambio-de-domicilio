@page
@model CambioDeDomicilio.Dashboard.Pages.IndexModel
@using CambioDeDomicilio.Domain
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Casos — CambioDeDomicilio</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body class="cases-page">
    <header class="app-header">
        <div class="brand">
            <img src="~/images/logo-municipalidad.png" alt="Municipalidad de Valparaíso" class="brand-logo" />
            <span>
                CambioDeDomicilio
                <small>Municipalidad de Valparaíso</small>
                <small>Solicitudes de carpeta</small>
            </span>
        </div>
        <nav class="app-nav">
            <div class="nav-group nav-group-filters">
                <a asp-page="/Index" class="@(Model.StatusFilter is null && !Model.OnlyNeedsReview && string.IsNullOrEmpty(Model.SearchQuery) ? "active" : "")">Todos</a>
                <a asp-page="/Index" asp-route-status="Pending" class="@(Model.StatusFilter == "Pending" ? "active" : "")">Pendientes</a>
                <a asp-page="/Index" asp-route-status="Uploaded" class="@(Model.StatusFilter == "Uploaded" ? "active" : "")">Subidos</a>
                <a asp-page="/Index" asp-route-status="Confirmed" class="@(Model.StatusFilter == "Confirmed" ? "active" : "")">Confirmados</a>
                <a asp-page="/Index" asp-route-needsReview="true" class="@(Model.OnlyNeedsReview ? "active" : "")">
                    Requiere revisión
                    @if (Model.NeedsReviewCount > 0)
                    {
                        <span class="badge badge-review">@Model.NeedsReviewCount</span>
                    }
                </a>
                @if (Model.BouncedCount > 0)
                {
                    <a asp-page="/Index" asp-route-bounced="true" class="@(Model.OnlyBounced ? "active" : "")">
                        Rebotados
                        <span class="badge badge-bounced">@Model.BouncedCount</span>
                    </a>
                }
            </div>

            <div class="nav-group nav-group-tools">
                <a asp-page="/Comunas">Comunas</a>
                <a asp-page="/Discarded">
                    Descartados
                    @if (Model.DiscardedCount > 0)
                    {
                        <span class="badge badge-review">@Model.DiscardedCount</span>
                    }
                </a>
            </div>

            <div class="nav-group nav-group-end">
                <form method="get" class="nav-search">
                    <input type="hidden" name="status" value="@Model.StatusFilter" />
                    <input type="hidden" name="needsReview" value="@Model.OnlyNeedsReview" />
                    <input type="hidden" name="bounced" value="@Model.OnlyBounced" />
                    <input type="text" name="search" id="search-input" placeholder="Buscar por RUT o nombre..." value="@Model.SearchQuery" data-had-value="@(!string.IsNullOrEmpty(Model.SearchQuery) ? "true" : "false")" oninput="formatSearchRut(this); clearSearchIfEmpty(this)" />
                    <button type="submit" class="nav-pill">Buscar</button>
                    @if (!string.IsNullOrEmpty(Model.SearchQuery))
                    {
                        <a asp-page="/Index" asp-route-status="@Model.StatusFilter" asp-route-needsReview="@Model.OnlyNeedsReview" asp-route-bounced="@Model.OnlyBounced" class="nav-search-clear">Limpiar</a>
                    }
                </form>
                <form method="post" asp-page-handler="SyncNow" id="sync-form" onsubmit="return handleSyncSubmit(this);"><button type="submit" class="nav-pill nav-sync">Sincronizar ahora</button></form>
            </div>
        </nav>
    </header>
    <div class="app-subnav">
        <span class="app-subnav-label">Otros sistemas</span>
        <a asp-page="/Index" class="nav-casos active">Cambio de Domicilio</a>
        <a asp-page="/F8" class="nav-f8">F8</a>
        <a asp-page="/Estadisticas" class="nav-estadisticas">Estadísticas</a>
        <a asp-page="/Sector" asp-route-sector="Archivo" class="nav-pdf-archivo">PDF Archivo</a>
        <a asp-page="/Sector" asp-route-sector="Oficina43" class="nav-pdf-oficina43">PDF Oficina 43</a>
    </div>

    <main>
        @if (Model.Message is not null)
        {
            <p class="message-banner @(Model.MessageIsError ? "message-error" : "")">@Model.Message</p>
        }

        <div class="card card-manual-entry">
            <form method="post" asp-page-handler="AddManualCases" id="manual-cases-form" class="manual-entry-form">
                <div class="form-group">
                    <label class="form-label" for="manual-comuna">Comuna</label>
                    <select name="comuna" id="manual-comuna" required class="form-control">
                        <option value="">Seleccione...</option>
                        @foreach (var contact in Model.ComunaOptions)
                        {
                            <option value="@contact.Comuna">@contact.Comuna</option>
                        }
                    </select>
                </div>

                <div id="manual-case-rows" class="manual-case-rows">
                    <div class="manual-case-row">
                        <div class="form-group">
                            <label class="form-label">Nombre completo</label>
                            <input type="text" name="nombre" required placeholder="ej: Gustavo Peña Castro"
                                   class="form-control" style="min-width: 240px;" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">RUT</label>
                            <input type="text" name="rut" required placeholder="ej: 18.785.387-7"
                                   class="form-control" style="min-width: 130px;" />
                        </div>
                        <button type="button" class="manual-case-remove" title="Quitar fila">&times;</button>
                    </div>
                </div>

                <button type="button" id="manual-case-add" class="btn-add-more">+ Agregar otro</button>
                <button type="submit" class="btn-primary">Agregar caso(s)</button>
            </form>
        </div>

        <script>
            (function () {
                var rowsContainer = document.getElementById('manual-case-rows');
                var addButton = document.getElementById('manual-case-add');
                if (!rowsContainer || !addButton) return;

                function addRow() {
                    var first = rowsContainer.querySelector('.manual-case-row');
                    var clone = first.cloneNode(true);
                    clone.querySelectorAll('input').forEach(function (input) { input.value = ''; });
                    rowsContainer.appendChild(clone);
                    clone.querySelector('input[name="nombre"]').focus();
                }

                addButton.addEventListener('click', addRow);

                rowsContainer.addEventListener('click', function (event) {
                    if (!event.target.classList.contains('manual-case-remove')) return;
                    var rows = rowsContainer.querySelectorAll('.manual-case-row');
                    if (rows.length > 1) {
                        event.target.closest('.manual-case-row').remove();
                    }
                });
            })();
        </script>

        <div class="card table-card">
            <table class="cases cases-index">
                <thead>
                    <tr>
                        <th style="white-space:nowrap;">
                            <span style="display:flex; flex-direction:column; align-items:center; gap:2px;">
                                Marcar
                                <form method="post" asp-page-handler="MarkAllVisible"
                                      asp-route-status="@Model.StatusFilter" asp-route-needsReview="@Model.OnlyNeedsReview">
                                    <input type="checkbox" class="marked-checkbox" title="Marcar/desmarcar todos los casos visibles"
                                           @(Model.AllVisibleMarked ? "checked" : "")
                                           onchange="this.nextElementSibling.value = this.checked; this.form.submit();" />
                                    <input type="hidden" name="marked" value="@(Model.AllVisibleMarked ? "true" : "false")" />
                                </form>
                            </span>
                        </th>
                        <th title="Marca un caso cuya carpeta física no fue posible localizar (solo fichas sin fecha o anteriores a 2000)">F8</th>
                        <th title="Marca la carpeta como pendiente de retiro — resalta la fila en amarillo">Pendiente<br />Carpeta</th>
                        <th>Nombre</th>
                        <th>RUT</th>
                        <th>Comuna</th>
                        <th>Recibido</th>
                        <th>Plazo (15 días hábiles)</th>
                        <th>Estado</th>
                        <th>Fecha última carpeta</th>
                        <th>Sector</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                @{ var rowIndex = 0; }
                @foreach (var item in Model.Cases)
                {
                    var rowClass = rowIndex % 2 == 1 ? "row-alt" : "";
                    var statusRowClass = item.Status == RequestStatus.Confirmed
                        ? "row-confirmed"
                        : (item.NeedsReview ? "row-needs-review" : "");
                    var f8PendingClass = item.FolderNotFound ? "row-f8-pending" : "";
                    var pendienteCarpetaClass = item.PendienteCarpeta ? "row-pendiente-carpeta" : "";
                    var bouncedClass = item.ConfirmationBouncedAt is not null ? "row-bounced" : "";
                    rowIndex++;
                    <tr class="@rowClass @statusRowClass @f8PendingClass @pendienteCarpetaClass @bouncedClass">
                        <td class="marked-cell">
                            <form method="post" asp-page-handler="ToggleMarked" class="marked-form">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="checkbox" name="markedValue" class="marked-checkbox"
                                       data-pdf-generated-at="@(item.SectorPdfGeneratedAt is { } pdfAt ? SpanishDate.Format(DateOnly.FromDateTime(pdfAt.LocalDateTime)) : "")"
                                       @(item.Marked ? "checked" : "") onchange="toggleMutuallyExclusive(this, 'markedValue', 'pendienteCarpetaValue')"
                                       title="@(item.Marked ? "Desmarcar caso" : "Marcar caso")" />
                            </form>
                        </td>
                        <td class="marked-cell">
                            <form method="post" asp-page-handler="ToggleFolderNotFound" class="marked-form">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="checkbox" name="folderNotFoundValue" class="marked-checkbox"
                                       @(item.FolderNotFound ? "checked" : "") onchange="submitCheckboxToggle(this, 'folderNotFoundValue')"
                                       title="F8 - Carpeta no encontrada" />
                            </form>
                        </td>
                        <td class="marked-cell">
                            <form method="post" asp-page-handler="TogglePendienteCarpeta" class="marked-form">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="checkbox" name="pendienteCarpetaValue" class="marked-checkbox"
                                       @(item.PendienteCarpeta ? "checked" : "") onchange="toggleMutuallyExclusive(this, 'pendienteCarpetaValue', 'markedValue')"
                                       title="@(item.PendienteCarpeta ? "Desmarcar pendiente carpeta" : "Marcar pendiente carpeta")" />
                            </form>
                        </td>
                        <td class="name-cell">
                            <form method="post" asp-page-handler="SetPersonData" id="person-form-@item.Id">
                                <input type="hidden" name="id" value="@item.Id" />
                            </form>
                            <span class="name-with-alert">
                            @if (item.NeedsReview)
                            {
                                <span class="review-alert" aria-label="Requiere revisión"
                                      title="Requiere revisión — datos no extraíbles del correo (asunto: @item.SourceSubject)">⚠</span>
                            }
                            @* min-width in `ch` (not the `size` attribute) sets the column's floor: `size` estimates
                               using the "0" glyph, which under-counts wide capitals (W, M) common in these names and
                               let the column collapse below what the actual text needs. width:100% (see CSS) then
                               lets each row's input still fill any extra space the widest name in the column grants it. *@
                            <input type="text" name="nombre" value="@item.FullName" placeholder="Nombre completo" required
                                   class="input-inline name-input" form="person-form-@item.Id" onchange="savePersonFieldIfDoneEditing(this)"
                                   title="@(item.NeedsReview ? $"Requiere revisión — datos no extraíbles del correo (asunto: {item.SourceSubject})" : "")" />
                            </span>
                        </td>
                        <td class="text-cell rut-cell">
                            <input type="text" name="rut" value="@item.Rut" placeholder="RUT" required size="13"
                                   class="input-inline rut-input" form="person-form-@item.Id" onchange="savePersonFieldIfDoneEditing(this)"
                                   oncopy="var s=this.value.substring(this.selectionStart,this.selectionEnd)||this.value; event.clipboardData.setData('text/plain', s.replace(/\./g,'')); event.preventDefault();" />
                        </td>
                        <td class="text-cell">@item.Comuna</td>
                        <td class="text-cell">@item.ReceivedAt.LocalDateTime.ToString("dd-MM-yyyy")</td>
                        <td>
                            @if (item.Status == RequestStatus.Pending)
                            {
                                var restantes = Model.DiasHabilesRestantes(item);
                                var plazoClass = restantes <= 3 ? "badge-review" : restantes <= 7 ? "badge-uploaded" : "badge-ok";
                                var plazoText = restantes < 0
                                    ? $"VENCIDO hace {-restantes} días"
                                    : $"quedan {restantes} días";
                                <span class="badge @plazoClass">@plazoText</span>
                            }
                            else
                            {
                                <span class="badge badge-confirmed">cumplido</span>
                            }
                        </td>
                        <td>
                            @{
                                var (badgeClass, badgeText) = item.Status switch
                                {
                                    RequestStatus.Pending => ("badge-pending", "Pendiente"),
                                    RequestStatus.Uploaded => ("badge-uploaded", "Subido"),
                                    RequestStatus.Confirmed => ("badge-confirmed", "Confirmado"),
                                    _ => ("badge-pending", item.Status.ToString())
                                };
                            }
                            <span class="badge @badgeClass">@badgeText</span>
                            @if (item.ConfirmationBouncedAt is { } bouncedAt)
                            {
                                <span class="badge badge-bounced"
                                      title="La confirmación a la comuna rebotó el @bouncedAt.LocalDateTime.ToString("dd-MM-yyyy") — la comuna no la recibió">REBOTÓ</span>
                            }
                        </td>
                        <td>
                            <form method="post" asp-page-handler="SetFecha" class="fecha-form">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="text" name="fecha" class="input-inline fecha-input" size="16"
                                       placeholder="ej: 15/03/2024"
                                       title="Formatos aceptados: 15/03/2024 o 15 marzo 2024"
                                       value="@(item.FechaUltimaCarpeta is { } f ? SpanishDate.Format(f) : "")"
                                       onchange="this.form.submit()" />
                            </form>
                        </td>
                        <td class="text-cell">@(item.Sector?.ToString() ?? "—")</td>
                        <td>
                            @if (item.Status == RequestStatus.Pending && !item.NeedsReview)
                            {
                                <!-- Both blocks always render for Pending cases; CSS (tr:has(input[name="folderNotFoundValue"]:checked))
                                     picks which one shows, live, the instant the F8 checkbox is toggled — ticking F8 goes through
                                     fetch() now (see submitCheckboxToggle), not a full-page reload, so without this the button here
                                     stayed frozen on whatever was true when the page last rendered until the operator refreshed. -->
                                <div class="transfer-choice f8-only">
                                    <form method="post" asp-page-handler="TransferToF8"
                                          onsubmit="return confirm('Esto moverá el caso a la pantalla F8 y desaparecerá de Casos. ¿Confirmar?');">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn-primary" title="Trasladar caso a la pantalla F8">Traspaso a F8</button>
                                    </form>
                                </div>
                                <form method="post" asp-page-handler="MarkUploadedAndConfirm" class="no-f8-only"
                                      onsubmit="return confirm('Esto moverá el correo a \'CARP. YA SUBIDAS\' y enviará la confirmación a la comuna de inmediato. ¿Confirmar?');">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn-primary" title="Mover correo a 'CARP. YA SUBIDAS' y enviar confirmación">Marcar subida</button>
                                </form>
                            }
                            else if (item.FolderNotFound)
                            {
                                <div class="transfer-choice">
                                    <form method="post" asp-page-handler="TransferToF8"
                                          onsubmit="return confirm('Esto moverá el caso a la pantalla F8 y desaparecerá de Casos. ¿Confirmar?');">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn-primary" title="Trasladar caso a la pantalla F8">Traspaso a F8</button>
                                    </form>
                                </div>
                            }
                            else if (item.Status == RequestStatus.Uploaded && !item.NeedsReview)
                            {
                                <form method="post" asp-page-handler="Confirm">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn-primary" title="Enviar confirmación">Confirmar</button>
                                </form>
                            }
                            else if (item.Status == RequestStatus.Confirmed)
                            {
                                <form method="post" asp-page-handler="RectifyConfirmation"
                                      onsubmit="return confirm('Esto enviará un correo de RECTIFICACIÓN a la comuna indicando que la confirmación anterior fue un error, y revertirá el caso a Pendiente. ¿Continuar?') && confirm('¿Estás completamente seguro? Se enviará un correo real a la comuna ahora mismo.');">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn-outline-danger" style="padding:4px 10px; font-size:0.72rem;" title="Enviar correo de rectificación y volver el caso a Pendiente">Deshacer y rectificar</button>
                                </form>
                            }
                            @if (item.ConfirmationBouncedAt is not null)
                            {
                                <form method="post" asp-page-handler="ResolveBounce"
                                      onsubmit="return confirm('Marca el rebote como resuelto (ya reenviaste la confirmación o lo gestionaste de otra forma). ¿Confirmar?');">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn-outline-danger" style="padding:4px 10px; font-size:0.72rem;" title="Marcar el rebote de confirmación como resuelto">Marcar resuelto</button>
                                </form>
                            }
                            <form method="post" asp-page-handler="DeleteCase"
                                  onsubmit="return confirm('Esto elimina el caso de forma permanente, no se puede deshacer. ¿Confirmar?');">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn-danger" title="Eliminar caso permanentemente" aria-label="Eliminar caso">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M3 6h18" />
                                        <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                                        <line x1="10" y1="11" x2="10" y2="17" />
                                        <line x1="14" y1="11" x2="14" y2="17" />
                                    </svg>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </main>
    <script>
        // Blurs active input on sync submit to ensure any pending onchange handlers fire and save
        function handleSyncSubmit(form) {
            if (document.activeElement && (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'SELECT')) {
                document.activeElement.blur();
            }
            return true;
        }

        // nombre and rut are two separate inputs sharing one form (person-form-ID), each
        // autosaving independently on change. Submitting on the nombre field's own onchange fires
        // as soon as it loses focus (e.g. tabbing into rut) — before rut has been typed — which
        // sends the request with rut still blank/stale and trips "RUT no válido". Deferring one
        // tick lets focus land on rut first; only submit once focus has actually left the form.
        function savePersonFieldIfDoneEditing(input) {
            var form = input.form;
            setTimeout(function () {
                if (document.activeElement && document.activeElement.form === form) {
                    return;
                }
                form.submit();
            }, 0);
        }

        // Marcar/F8 checkboxes used this.form.submit() (full-page navigation) before. Ticking
        // several rows quickly fired one navigation per checkbox, but a browser only runs one
        // navigation at a time — earlier ones got cancelled mid-flight, so only the last checkbox
        // (or whichever one wins the race) actually persisted, silently losing the rest. fetch()
        // keeps each toggle an independent request that can't cancel its siblings.
        function submitCheckboxToggle(checkbox, fieldName) {
            var form = checkbox.form;
            var id = form.querySelector('input[name="id"]').value;
            var token = form.querySelector('input[name="__RequestVerificationToken"]').value;
            var body = '__RequestVerificationToken=' + encodeURIComponent(token) + '&id=' + encodeURIComponent(id);
            if (checkbox.checked) {
                body += '&' + fieldName + '=on';
            }
            fetch(form.action, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: body
            });
        }

        // Marcar and Pendiente Carpeta are mutually exclusive (a row is either green or yellow,
        // never both) but not locked — checking one clears the other automatically, and the
        // cleared one can still be re-checked manually afterward at any time.
        function toggleMutuallyExclusive(checkbox, fieldName, otherFieldName) {
            // Re-marking a case that already had a PDF generated resets SectorPdfGeneratedAt
            // server-side so it prints again — let the operator know that's what's happening.
            if (fieldName === 'markedValue' && checkbox.checked && checkbox.dataset.pdfGeneratedAt) {
                alert('Ya se había generado un PDF para esta persona el ' + checkbox.dataset.pdfGeneratedAt + '. Se incluirá de nuevo en el próximo PDF.');
            }
            submitCheckboxToggle(checkbox, fieldName);
            if (checkbox.checked) {
                var row = checkbox.closest('tr');
                var other = row ? row.querySelector('input[name="' + otherFieldName + '"]') : null;
                if (other && other.checked) {
                    other.checked = false;
                    submitCheckboxToggle(other, otherFieldName);
                }
            }
        }
    </script>
    <script>
        // Replaces the old <meta http-equiv="refresh" content="120"> — that one fired blind, even
        // while the tab was minimized or the operator had a field focused mid-edit, silently
        // discarding whatever they were typing. This checks document.hidden and activeElement
        // before reloading, and just reschedules for later instead of skipping the refresh outright.
        (function () {
            var REFRESH_MS = 120000;
            function scheduleRefresh() {
                setTimeout(function () {
                    var typing = document.activeElement && document.activeElement !== document.body
                        && document.activeElement.tagName !== 'BUTTON'
                        && document.activeElement.tagName !== 'A';
                    if (document.hidden || typing) {
                        scheduleRefresh();
                        return;
                    }
                    window.location.reload();
                }, REFRESH_MS);
            }
            scheduleRefresh();
        })();
    </script>
    <script src="~/js/scroll-preserve.js" asp-append-version="true"></script>
    <script>
        // Auto-formats a RUT typed as raw digits (e.g. "135516122") into the standard
        // "13.551.612-2" shape as the operator types. Only kicks in when the field is all
        // digits (plus an optional trailing K check digit) — a name search is left untouched.
        function formatSearchRut(input) {
            var raw = input.value;
            if (!/^\d+[kK]?$/.test(raw.replace(/[.\-]/g, ''))) {
                return;
            }

            var clean = raw.replace(/[.\-]/g, '');
            if (clean.length < 2) {
                return;
            }

            var body = clean.slice(0, -1);
            var dv = clean.slice(-1).toUpperCase();
            var formattedBody = body.replace(/\B(?=(\d{3})+(?!\d))/g, '.');

            input.value = formattedBody + '-' + dv;
        }

        // Deleting the search text down to empty submits the search form right away, so the
        // table snaps back to the full unfiltered list instead of waiting for the operator to
        // hit "Buscar" or notice the "Limpiar" link.
        function clearSearchIfEmpty(input) {
            if (input.value === '' && input.dataset.hadValue === 'true') {
                input.form.submit();
            }
            input.dataset.hadValue = input.value !== '' ? 'true' : 'false';
        }
    </script>
</body>
</html>
