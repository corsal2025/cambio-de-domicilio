@page
@model CambioDeDomicilio.Dashboard.Pages.IndexModel
@using CambioDeDomicilio.Domain
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Casos — CambioDeDomicilio</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body class="cases-page">
    <header class="app-header">
        <div class="brand">
            <img src="~/images/logo-municipalidad.png" alt="Municipalidad de Valparaíso" class="brand-logo" />
            <span>
                CambioDeDomicilio
                <small>Municipalidad de Valparaíso</small>
                <small>Solicitudes de carpeta</small>
            </span>
        </div>
        <nav class="app-nav">
            <div class="nav-group nav-group-filters">
                <a asp-page="/Index" class="@(Model.StatusFilter is null && !Model.OnlyNeedsReview && string.IsNullOrEmpty(Model.SearchQuery) ? "active" : "")"><partial name="_NavIcon" model="@("list")" /><span>Todos</span></a>
                <a asp-page="/Index" asp-route-status="Pending" class="@(Model.StatusFilter == "Pending" ? "active" : "")"><partial name="_NavIcon" model="@("clock")" /><span>Pendientes</span></a>
                <a asp-page="/Index" asp-route-status="Uploaded" class="@(Model.StatusFilter == "Uploaded" ? "active" : "")"><partial name="_NavIcon" model="@("upload")" /><span>Subidos</span></a>
                <a asp-page="/Index" asp-route-status="Confirmed" class="@(Model.StatusFilter == "Confirmed" ? "active" : "")"><partial name="_NavIcon" model="@("check")" /><span>Confirmados</span></a>
                <a asp-page="/Index" asp-route-needsReview="true" class="@(Model.OnlyNeedsReview ? "active" : "")">
                    <partial name="_NavIcon" model="@("alert")" /><span>Requiere revisión</span>
                    @if (Model.NeedsReviewCount > 0)
                    {
                        <span class="badge badge-review">@Model.NeedsReviewCount</span>
                    }
                </a>
                @if (Model.BouncedCount > 0)
                {
                    <a asp-page="/Index" asp-route-bounced="true" class="@(Model.OnlyBounced ? "active" : "")">
                        <partial name="_NavIcon" model="@("bounce")" /><span>Rebotados</span>
                        <span class="badge badge-bounced">@Model.BouncedCount</span>
                    </a>
                }
            </div>

            <div class="nav-group nav-group-tools">
                <a asp-page="/Comunas"><partial name="_NavIcon" model="@("map")" /><span>Comunas</span></a>
                <a asp-page="/Discarded">
                    <partial name="_NavIcon" model="@("discarded")" /><span>Descartados</span>
                    @if (Model.DiscardedCount > 0)
                    {
                        <span class="badge badge-review">@Model.DiscardedCount</span>
                    }
                </a>
            </div>

            <div class="nav-group nav-group-end">
                <form method="get" class="nav-search">
                    <input type="hidden" name="status" value="@Model.StatusFilter" />
                    <input type="hidden" name="needsReview" value="@Model.OnlyNeedsReview" />
                    <input type="hidden" name="bounced" value="@Model.OnlyBounced" />
                    <input type="text" name="search" id="search-input" placeholder="Buscar por RUT o nombre..." value="@Model.SearchQuery" data-had-value="@(!string.IsNullOrEmpty(Model.SearchQuery) ? "true" : "false")" oninput="formatSearchRut(this); clearSearchIfEmpty(this)" />
                    <button type="submit" class="nav-pill"><partial name="_NavIcon" model="@("search")" /><span>Buscar</span></button>
                    @if (!string.IsNullOrEmpty(Model.SearchQuery))
                    {
                        <a asp-page="/Index" asp-route-status="@Model.StatusFilter" asp-route-needsReview="@Model.OnlyNeedsReview" asp-route-bounced="@Model.OnlyBounced" class="nav-search-clear"><partial name="_NavIcon" model="@("clear")" /><span>Limpiar</span></a>
                    }
                </form>
                <form method="post" asp-page-handler="SyncNow" id="sync-form" onsubmit="return handleSyncSubmit(this);"><button type="submit" class="nav-pill nav-sync"><partial name="_NavIcon" model="@("sync")" /><span>Sincronizar ahora</span></button></form>
            </div>
        </nav>
    </header>
    <div class="app-subnav">
        <div class="app-subnav-main">
            <span class="app-subnav-label">Sistemas</span>
            <a asp-page="/Index" class="nav-casos active"><partial name="_NavIcon" model="@("home")" /><span>Cambio de Domicilio</span></a>
            <a asp-page="/F8" class="nav-f8"><partial name="_NavIcon" model="@("f8")" /><span>F8</span></a>
            <a asp-page="/SinCarpetas" class="nav-sin-carpetas"><partial name="_NavIcon" model="@("sin-carpetas")" /><span>Sin Carpetas</span></a>
            <a asp-page="/Caja" class="nav-caja"><partial name="_NavIcon" model="@("caja")" /><span>Caja</span></a>
            <a asp-page="/Estadisticas" class="nav-estadisticas"><partial name="_NavIcon" model="@("stats")" /><span>Estadísticas</span></a>
        </div>
        <div class="app-subnav-docs">
            <span class="app-subnav-label">Documentos</span>
            <a asp-page="/Sector" asp-route-sector="Archivo" class="nav-pdf-archivo" title="Generar listado para Archivo">
                <partial name="_NavIcon" model="@("pdf")" /><span>PDF Archivo</span>
            </a>
            <a asp-page="/Sector" asp-route-sector="Oficina43" class="nav-pdf-oficina43" title="Generar listado para Oficina 43">
                <partial name="_NavIcon" model="@("pdf")" /><span>PDF Oficina 43</span>
            </a>
        </div>
    </div>

    <main>
        @if (Model.Message is not null)
        {
            <p class="message-banner @(Model.MessageIsError ? "message-error" : "")">@Model.Message</p>
        }

        @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
        {
            if (Model.Cases.Count == 0 && Model.F8MatchCount > 0)
            {
                <div class="cross-search-banner">
                    <span class="cross-search-icon">🔍</span>
                    <div class="cross-search-text">
                        No se encontraron casos en Cambio de Domicilio para <strong>"@Model.SearchQuery"</strong>, pero existe(n) <strong>@Model.F8MatchCount caso(s)</strong> en <strong>Casos F8</strong>.
                    </div>
                    <a asp-page="/F8" asp-route-search="@Model.SearchQuery" asp-route-highlightId="@Model.F8FirstMatchId" class="btn-cross-search">
                        Ver y seleccionar en F8 &rarr;
                    </a>
                </div>
            }
            else if (Model.Cases.Count > 0 && Model.F8MatchCount > 0)
            {
                <div class="cross-search-banner cross-search-banner-info">
                    <span class="cross-search-icon">ℹ️</span>
                    <div class="cross-search-text">
                        Esta persona también tiene <strong>@Model.F8MatchCount caso(s)</strong> registrado(s) en <strong>Casos F8</strong>.
                    </div>
                    <a asp-page="/F8" asp-route-search="@Model.SearchQuery" asp-route-highlightId="@Model.F8FirstMatchId" class="btn-cross-search">
                        Ver y seleccionar en F8 &rarr;
                    </a>
                </div>
            }

            if (Model.CajaMatches.Count > 0)
            {
                <div class="caja-location-banner">
                    <div class="caja-location-title">
                        <partial name="_NavIcon" model="@("caja")" />
                        <span>Carpeta física en Caja — ubicación exacta</span>
                    </div>
                    <ul class="caja-location-list">
                    @foreach (var location in Model.CajaMatches)
                    {
                        <li class="caja-location-item">
                            <span class="caja-location-name">@location.FullName</span>
                            @if (location.BoxId is { } locationBoxId)
                            {
                                <span class="caja-location-where">
                                    Caja <strong>@location.BoxCode</strong>
                                    · listado cerrado el <strong>@(location.ClosedAt?.LocalDateTime.ToString("dd-MM-yyyy HH:mm"))</strong>
                                    · <span class="caja-location-position">N° @location.Position</span>
                                </span>
                                <a asp-page="/Caja" asp-route-boxId="@locationBoxId" asp-route-highlightId="@location.CaseId" asp-fragment="case-@location.CaseId"
                                   class="btn-action btn-action--caja" title="Abrir ese listado con la carpeta resaltada">
                                    <partial name="_ActionIcon" model="@("caja")" /><span>Ir al listado</span>
                                </a>
                            }
                            else
                            {
                                <span class="caja-location-where">
                                    <strong>Cola de Caja</strong> (aún sin cerrar)
                                    · <span class="caja-location-position">N° @location.Position</span>
                                </span>
                                <a asp-page="/Caja" asp-route-highlightId="@location.CaseId" asp-fragment="case-@location.CaseId"
                                   class="btn-action btn-action--caja" title="Abrir la cola con la carpeta resaltada">
                                    <partial name="_ActionIcon" model="@("caja")" /><span>Ir a la cola</span>
                                </a>
                            }
                        </li>
                    }
                    </ul>
                </div>
            }
        }

        <div class="card card-manual-entry">
            <form method="post" asp-page-handler="AddManualCases" id="manual-cases-form" class="manual-entry-form">
                <div class="form-group">
                    <label class="form-label" for="manual-comuna">Comuna</label>
                    <select name="comuna" id="manual-comuna" required class="form-control">
                        <option value="">Seleccione...</option>
                        @foreach (var contact in Model.ComunaOptions)
                        {
                            <option value="@contact.Comuna">@contact.Comuna</option>
                        }
                    </select>
                </div>

                <div id="manual-case-rows" class="manual-case-rows">
                    <div class="manual-case-row">
                        <div class="form-group">
                            <label class="form-label">Nombre completo</label>
                            <input type="text" name="nombre" required placeholder="ej: Gustavo Peña Castro"
                                   class="form-control" style="min-width: 240px;" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">RUT</label>
                            <input type="text" name="rut" required placeholder="ej: 18.785.387-7"
                                   class="form-control" style="min-width: 130px;" />
                        </div>
                        <button type="button" class="manual-case-remove" title="Quitar fila">&times;</button>
                    </div>
                </div>

                <button type="button" id="manual-case-add" class="btn-add-more">+ Agregar otro</button>
                <label class="legacy-caja-option" for="manual-direct-to-caja" title="Para carpetas antiguas que nunca se registraron: van directo a la cola de Caja y NO se envía correo a la comuna.">
                    <input type="checkbox" id="manual-direct-to-caja" name="directToCaja" value="true" />
                    <span>Carpeta antigua: enviar directo a Caja (sin correo)</span>
                </label>
                <button type="submit" class="btn-primary">Agregar caso(s)</button>
            </form>
        </div>

        <script>
            (function () {
                var rowsContainer = document.getElementById('manual-case-rows');
                var addButton = document.getElementById('manual-case-add');
                if (!rowsContainer || !addButton) return;

                function addRow() {
                    var first = rowsContainer.querySelector('.manual-case-row');
                    var clone = first.cloneNode(true);
                    clone.querySelectorAll('input').forEach(function (input) { input.value = ''; });
                    rowsContainer.appendChild(clone);
                    clone.querySelector('input[name="nombre"]').focus();
                }

                addButton.addEventListener('click', addRow);

                rowsContainer.addEventListener('click', function (event) {
                    if (!event.target.classList.contains('manual-case-remove')) return;
                    var rows = rowsContainer.querySelectorAll('.manual-case-row');
                    if (rows.length > 1) {
                        event.target.closest('.manual-case-row').remove();
                    }
                });
            })();
        </script>

        <div class="card table-card">
            <table class="cases cases-index">
                <thead>
                    <tr class="header-groups">
                        <th colspan="2" class="th-group th-group-frozen th-group-1 th-group-frozen-end">Contribuyente</th>
                        <th colspan="3" class="th-group">Marcado</th>
                        <th class="th-group">Destino</th>
                        <th colspan="3" class="th-group">Plazos y Estado</th>
                        <th colspan="2" class="th-group">Carpeta física</th>
                        <th class="th-group">Acción</th>
                    </tr>
                    <tr class="header-cols">
                        <th>Nombre</th>
                        <th>RUT</th>
                        <th>
                            <div style="display:inline-flex; flex-direction:column; align-items:center; gap:3px; justify-content:center;">
                                <span>Marcar</span>
                                <form method="post" asp-page-handler="MarkAllVisible"
                                      asp-route-status="@Model.StatusFilter" asp-route-needsReview="@Model.OnlyNeedsReview" style="display:inline-flex; margin:0;">
                                    <input type="checkbox" class="marked-checkbox" title="Marcar/desmarcar todos los casos visibles"
                                           @(Model.AllVisibleMarked ? "checked" : "")
                                           onchange="this.nextElementSibling.value = this.checked; this.form.submit();" />
                                    <input type="hidden" name="marked" value="@(Model.AllVisibleMarked ? "true" : "false")" />
                                </form>
                            </div>
                        </th>
                        <th title="Marca un caso cuya carpeta física no fue posible localizar (solo fichas sin fecha o anteriores a 2000)">F8</th>
                        <th title="Marca la carpeta como pendiente de retiro — resalta la fila en morado">Pendiente<br />Carpeta</th>
                        <th>Comuna</th>
                        <th>Recibido</th>
                        <th>Plazo<br /><span class="th-subtext">(15 días hábiles)</span></th>
                        <th>Estado</th>
                        <th>Fecha última<br />Carpeta</th>
                        <th>Sector</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Cases)
                {
                    var statusRowClass = item.NeedsReview
                        ? "row-needs-review"
                        : (item.IsActionCompleted ? "row-done" : "");
                    var markedClass = item.Marked ? "row-marked" : "";
                    var f8PendingClass = item.FolderNotFound ? "row-f8-pending" : "";
                    var pendienteCarpetaClass = item.PendienteCarpeta ? "row-pendiente-carpeta" : "";
                    var bouncedClass = item.ConfirmationBouncedAt is not null ? "row-bounced" : "";
                    <tr class="@statusRowClass @markedClass @f8PendingClass @pendienteCarpetaClass @bouncedClass">
                        <td class="name-cell">
                            <form method="post" asp-page-handler="SetPersonData" id="person-form-@item.Id">
                                <input type="hidden" name="id" value="@item.Id" />
                            </form>
                            <span class="name-with-alert">
                            @if (item.NeedsReview)
                            {
                                <span class="review-alert" aria-label="Requiere revisión"
                                      title="Requiere revisión — datos no extraíbles del correo (asunto: @item.SourceSubject)">⚠</span>
                            }
                            @* size in characters (not `ch` width) drives the column's real width — the column
                               auto-fits to the widest name in it because each row's input reports its own
                               intrinsic width via `size`, computed from the actual name length (+2 padding,
                               floor of 12 so short names don't collapse the column below a usable minimum,
                               no ceiling so the full name is always visible). *@
                            <input type="text" name="nombre" value="@item.FullName" placeholder="Nombre completo" required
                                   size="@Math.Max((item.FullName?.Length ?? 0) + 2, 12)"
                                   class="input-inline name-input" form="person-form-@item.Id" onchange="savePersonFieldIfDoneEditing(this)"
                                   title="@(item.NeedsReview ? $"Requiere revisión — datos no extraíbles del correo (asunto: {item.SourceSubject})" : item.FullName)" />
                            </span>
                        </td>
                        <td class="text-cell rut-cell">
                            <input type="text" name="rut" value="@item.Rut" placeholder="RUT" required size="13"
                                   class="input-inline rut-input" form="person-form-@item.Id" onchange="savePersonFieldIfDoneEditing(this)"
                                   oncopy="var s=this.value.substring(this.selectionStart,this.selectionEnd)||this.value; event.clipboardData.setData('text/plain', s.replace(/\./g,'')); event.preventDefault();" />
                        </td>
                        <td class="marked-cell">
                            <form method="post" asp-page-handler="ToggleMarked" class="marked-form">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="checkbox" name="markedValue" class="marked-checkbox"
                                       data-pdf-generated-at="@(item.SectorPdfGeneratedAt is { } pdfAt ? SpanishDate.Format(DateOnly.FromDateTime(pdfAt.LocalDateTime)) : "")"
                                       @(item.Marked ? "checked" : "") onchange="toggleRowCheckbox(this, 'markedValue')"
                                       title="@(item.Marked ? "Desmarcar caso" : "Marcar caso")" />
                            </form>
                        </td>
                        <td class="marked-cell f8-cell">
                            <form method="post" asp-page-handler="ToggleFolderNotFound" class="marked-form">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="checkbox" name="folderNotFoundValue" class="marked-checkbox"
                                       @(item.FolderNotFound ? "checked" : "") onchange="toggleRowCheckbox(this, 'folderNotFoundValue')"
                                       title="F8 - Carpeta no encontrada" />
                            </form>
                        </td>
                        <td class="marked-cell">
                            <form method="post" asp-page-handler="TogglePendienteCarpeta" class="marked-form">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="checkbox" name="pendienteCarpetaValue" class="marked-checkbox"
                                       @(item.PendienteCarpeta ? "checked" : "") onchange="toggleRowCheckbox(this, 'pendienteCarpetaValue')"
                                       title="@(item.PendienteCarpeta ? "Desmarcar pendiente carpeta" : "Marcar pendiente carpeta")" />
                            </form>
                        </td>
                        <td class="text-cell">@item.Comuna</td>
                        <td class="text-cell">@item.ReceivedAt.LocalDateTime.ToString("dd-MM-yyyy")</td>
                        <td>
                            @if (item.Status == RequestStatus.Pending)
                            {
                                var restantes = Model.DiasHabilesRestantes(item);
                                var plazoClass = restantes <= 3 ? "badge-review" : restantes <= 7 ? "badge-uploaded" : "badge-ok";
                                var plazoText = restantes < 0
                                    ? $"VENCIDO hace {-restantes} días"
                                    : $"quedan {restantes} días";
                                <span class="badge @plazoClass">@plazoText</span>
                            }
                            else
                            {
                                <span class="badge badge-confirmed">cumplido</span>
                            }
                        </td>
                        <td>
                            @{
                                var (badgeClass, badgeText) = item.Status switch
                                {
                                    RequestStatus.Pending => ("badge-pending", "Pendiente"),
                                    RequestStatus.Uploaded => ("badge-uploaded", "Subido"),
                                    RequestStatus.Confirmed => ("badge-confirmed", "Confirmado"),
                                    _ => ("badge-pending", item.Status.ToString())
                                };
                            }
                            @if (item.ClosedWithoutFolderAt is not null)
                            {
                                <span class="badge badge-closed" title="Proceso cerrado sin carpeta física">Cerrado sin carpeta</span>
                            }
                            else
                            {
                                <span class="badge @badgeClass">@badgeText</span>
                            }
                            @if (item.ConfirmationBouncedAt is { } bouncedAt)
                            {
                                <span class="badge badge-bounced"
                                      title="La confirmación a la comuna rebotó el @bouncedAt.LocalDateTime.ToString("dd-MM-yyyy") — la comuna no la recibió">REBOTÓ</span>
                            }
                        </td>
                        <td>
                            <form method="post" asp-page-handler="SetFecha" class="fecha-form">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="text" name="fecha" class="input-inline fecha-input" size="16"
                                       placeholder="ej: 15/03/2024"
                                       title="Formatos aceptados: 15/03/2024 o 15 marzo 2024"
                                       value="@(item.FechaUltimaCarpeta is { } f ? SpanishDate.Format(f) : "")"
                                       onchange="this.form.submit()" />
                            </form>
                        </td>
                        <td class="text-cell">@item.Sector.ToDisplayName()</td>
                        <td>
                            <div class="action-group">
                            @if (item.ClosedWithoutFolderAt is not null)
                            {
                                @* Closed without folder: process finished, no actions except delete. *@
                            }
                            else if (item.SoloCaja)
                            {
                                @* Reincorporated from F8 (folder found): only Caja, never upload/confirm/email. *@
                                <form method="post" asp-page-handler="SubirACaja">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn-action btn-action--caja" title="Enviar la carpeta a la cola de Caja (sin enviar correo)" aria-label="Enviar a Caja">
                                        <partial name="_ActionIcon" model="@("caja")" /><span>Caja</span>
                                    </button>
                                </form>
                            }
                            else if (item.Status == RequestStatus.Pending && !item.NeedsReview)
                            {
                                <!-- Both forms always render for Pending cases; CSS (tr:has(input[name="folderNotFoundValue"]:checked))
                                     picks which one shows, live, the instant the F8 checkbox is toggled — ticking F8 goes through
                                     fetch() (see submitCheckboxToggle), not a full-page reload. -->
                                <form method="post" asp-page-handler="TransferToF8" class="f8-only"
                                      onsubmit="return confirm('Esto moverá el caso a la pantalla F8 y desaparecerá de Casos. ¿Confirmar?');">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn-action btn-action--f8" title="Trasladar caso a la pantalla F8" aria-label="Traspaso a F8">
                                        <partial name="_ActionIcon" model="@("f8")" /><span>Traspaso a F8</span>
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="MarkUploadedAndConfirm" class="no-f8-only"
                                      onsubmit="return confirm('Esto moverá el correo a \'CARP. YA SUBIDAS\' y enviará la confirmación a la comuna de inmediato. ¿Confirmar?');">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn-action btn-action--upload" title="Mover correo a 'CARP. YA SUBIDAS' y enviar confirmación" aria-label="Marcar subida">
                                        <partial name="_ActionIcon" model="@("upload")" /><span>Marcar subida</span>
                                    </button>
                                </form>
                            }
                            else if (item.FolderNotFound)
                            {
                                <form method="post" asp-page-handler="TransferToF8"
                                      onsubmit="return confirm('Esto moverá el caso a la pantalla F8 y desaparecerá de Casos. ¿Confirmar?');">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn-action btn-action--f8" title="Trasladar caso a la pantalla F8" aria-label="Traspaso a F8">
                                        <partial name="_ActionIcon" model="@("f8")" /><span>Traspaso a F8</span>
                                    </button>
                                </form>
                            }
                            else if (item.Status == RequestStatus.Uploaded && !item.NeedsReview)
                            {
                                <form method="post" asp-page-handler="Confirm">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn-action btn-action--confirm" title="Enviar confirmación a la comuna" aria-label="Confirmar">
                                        <partial name="_ActionIcon" model="@("confirm")" /><span>Confirmar</span>
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="SubirACaja">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn-action btn-action--caja" title="Enviar la carpeta a la cola de Caja (sin enviar correo)" aria-label="Enviar a Caja">
                                        <partial name="_ActionIcon" model="@("caja")" /><span>Caja</span>
                                    </button>
                                </form>
                            }
                            else if (item.Status == RequestStatus.Confirmed)
                            {
                                <form method="post" asp-page-handler="SubirACaja">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn-action btn-action--caja" title="Enviar la carpeta a la cola de Caja (sin enviar correo)" aria-label="Enviar a Caja">
                                        <partial name="_ActionIcon" model="@("caja")" /><span>Caja</span>
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="RectifyConfirmation"
                                      onsubmit="return confirm('Esto enviará un correo de RECTIFICACIÓN a la comuna indicando que la confirmación anterior fue un error, y revertirá el caso a Pendiente. ¿Continuar?') && confirm('¿Estás completamente seguro? Se enviará un correo real a la comuna ahora mismo.');">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn-action btn-action--rectify" title="Enviar correo de rectificación y volver el caso a Pendiente" aria-label="Deshacer y rectificar">
                                        <partial name="_ActionIcon" model="@("rectify")" /><span>Rectificar</span>
                                    </button>
                                </form>
                            }
                            @if (item.ConfirmationBouncedAt is not null)
                            {
                                <form method="post" asp-page-handler="ResolveBounce"
                                      onsubmit="return confirm('Marca el rebote como resuelto (ya reenviaste la confirmación o lo gestionaste de otra forma). ¿Confirmar?');">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn-action btn-action--resolve" title="Marcar el rebote de confirmación como resuelto" aria-label="Marcar resuelto">
                                        <partial name="_ActionIcon" model="@("resolve")" /><span>Resuelto</span>
                                    </button>
                                </form>
                            }
                            <form method="post" asp-page-handler="DeleteCase"
                                  onsubmit="return confirm('Esto elimina el caso de forma permanente, no se puede deshacer. ¿Confirmar?');">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn-action btn-action--delete" title="Eliminar caso permanentemente" aria-label="Eliminar caso">
                                    <partial name="_ActionIcon" model="@("delete")" />
                                </button>
                            </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </main>
    <script>
        // Blurs active input on sync submit to ensure any pending onchange handlers fire and save
        function handleSyncSubmit(form) {
            if (document.activeElement && (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'SELECT')) {
                document.activeElement.blur();
            }
            return true;
        }

        // nombre and rut are two separate inputs sharing one form (person-form-ID), each
        // autosaving independently on change. Submitting on the nombre field's own onchange fires
        // as soon as it loses focus (e.g. tabbing into rut) — before rut has been typed — which
        // sends the request with rut still blank/stale and trips "RUT no válido". Deferring one
        // tick lets focus land on rut first; only submit once focus has actually left the form.
        function savePersonFieldIfDoneEditing(input) {
            var form = input.form;
            setTimeout(function () {
                if (document.activeElement && document.activeElement.form === form) {
                    return;
                }
                form.submit();
            }, 0);
        }

        // Marcar/F8 checkboxes used this.form.submit() (full-page navigation) before. Ticking
        // several rows quickly fired one navigation per checkbox, but a browser only runs one
        // navigation at a time — earlier ones got cancelled mid-flight, so only the last checkbox
        // (or whichever one wins the race) actually persisted, silently losing the rest. fetch()
        // keeps each toggle an independent request that can't cancel its siblings.
        function submitCheckboxToggle(checkbox, fieldName) {
            var form = checkbox.form;
            var id = form.querySelector('input[name="id"]').value;
            var token = form.querySelector('input[name="__RequestVerificationToken"]').value;
            var body = '__RequestVerificationToken=' + encodeURIComponent(token) + '&id=' + encodeURIComponent(id);
            if (checkbox.checked) {
                body += '&' + fieldName + '=on';
            }
            fetch(form.action, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: body
            });
        }

        // Marcar, F8 y Pendiente Carpeta son mutuamente excluyentes en la misma fila:
        // marcar una desmarca automáticamente las otras dos en la interfaz y en el servidor.
        function toggleRowCheckbox(checkbox, fieldName) {
            if (checkbox.checked) {
                if (fieldName === 'markedValue' && checkbox.dataset.pdfGeneratedAt) {
                    alert('Ya se había generado un PDF para esta persona el ' + checkbox.dataset.pdfGeneratedAt + '. Se incluirá de nuevo en el próximo PDF.');
                }
                var row = checkbox.closest('tr');
                if (row) {
                    row.querySelectorAll('.marked-checkbox').forEach(function (other) {
                        if (other !== checkbox) {
                            other.checked = false;
                        }
                    });
                }
            }
            submitCheckboxToggle(checkbox, fieldName);
        }
    </script>
    <script>
        // Replaces the old <meta http-equiv="refresh" content="120"> — that one fired blind, even
        // while the tab was minimized or the operator had a field focused mid-edit, silently
        // discarding whatever they were typing. This checks document.hidden and activeElement
        // before reloading, and just reschedules for later instead of skipping the refresh outright.
        (function () {
            var REFRESH_MS = 120000;
            function scheduleRefresh() {
                setTimeout(function () {
                    var typing = document.activeElement && document.activeElement !== document.body
                        && document.activeElement.tagName !== 'BUTTON'
                        && document.activeElement.tagName !== 'A';
                    if (document.hidden || typing) {
                        scheduleRefresh();
                        return;
                    }
                    window.location.reload();
                }, REFRESH_MS);
            }
            scheduleRefresh();
        })();
    </script>
    <script src="~/js/scroll-preserve.js" asp-append-version="true"></script>
    <script>
        // Every POST form carries the current list state (filter + search) as hidden fields, so
        // the handler's redirect lands on the same filtered list. Injected up front (not on
        // "submit") because several forms are submitted via form.submit(), which skips that event.
        (function () {
            var params = new URLSearchParams(window.location.search);
            var stateNames = ['status', 'needsReview', 'bounced', 'search'];
            document.querySelectorAll('form[method="post"]').forEach(function (form) {
                stateNames.forEach(function (name) {
                    var value = params.get(name);
                    if (value === null || value === '' || form.querySelector('[name="' + name + '"]')) return;
                    var hidden = document.createElement('input');
                    hidden.type = 'hidden';
                    hidden.name = name;
                    hidden.value = value;
                    form.appendChild(hidden);
                });
            });
        })();
    </script>
    <script>
        // Auto-formats a RUT typed as raw digits (e.g. "135516122") into the standard
        // "13.551.612-2" shape as the operator types. Only kicks in when the field is all
        // digits (plus an optional trailing K check digit) — a name search is left untouched.
        function formatSearchRut(input) {
            var raw = input.value;
            if (!/^\d+[kK]?$/.test(raw.replace(/[.\-]/g, ''))) {
                return;
            }

            var clean = raw.replace(/[.\-]/g, '');
            if (clean.length < 2) {
                return;
            }

            var body = clean.slice(0, -1);
            var dv = clean.slice(-1).toUpperCase();
            var formattedBody = body.replace(/\B(?=(\d{3})+(?!\d))/g, '.');

            input.value = formattedBody + '-' + dv;
        }

        // Deleting the search text down to empty submits the search form right away, so the
        // table snaps back to the full unfiltered list instead of waiting for the operator to
        // hit "Buscar" or notice the "Limpiar" link.
        function clearSearchIfEmpty(input) {
            if (input.value === '' && input.dataset.hadValue === 'true') {
                input.form.submit();
            }
            input.dataset.hadValue = input.value !== '' ? 'true' : 'false';
        }
    </script>
    <script>
        (function () {
            var table = document.querySelector('table.cases-index');
            if (!table) return;

            var isF8 = table.classList.contains('cases-f8');
            var freezeCount = 2; // Nombre + RUT
            var headerCells = table.querySelectorAll('thead tr.header-cols > *');
            var groupRow = table.querySelector('thead tr.header-groups');

            function setFreezeOffsets() {
                var cumulative = 0;
                for (var i = 0; i < freezeCount && i < headerCells.length; i++) {
                    cumulative += headerCells[i].getBoundingClientRect().width;
                    if (i < freezeCount - 1) {
                        table.style.setProperty('--freeze-left-' + (i + 2), cumulative + 'px');
                    }
                }
                if (groupRow) {
                    table.style.setProperty('--header-row2-top', groupRow.getBoundingClientRect().height + 'px');
                }
            }

            setFreezeOffsets();

            if (document.fonts && document.fonts.ready) {
                document.fonts.ready.then(setFreezeOffsets);
            }

            if (window.ResizeObserver) {
                var ro = new ResizeObserver(setFreezeOffsets);
                ro.observe(table);
            } else {
                var resizeTimer = null;
                window.addEventListener('resize', function () {
                    clearTimeout(resizeTimer);
                    resizeTimer = setTimeout(setFreezeOffsets, 100);
                });
            }
        })();
    </script>
    <partial name="_AuthorFooter" />
</body>
</html>
