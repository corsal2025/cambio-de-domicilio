@page "{sector?}"
@model CambioDeDomicilio.Dashboard.Pages.SectorF8Model
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Documento F8 — @Model.SelectedSector</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <style>
        .doc-sheet {
            background: #fff;
        }

        .doc-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            border-bottom: 3px solid var(--color-primary);
            padding-bottom: 14px;
            margin-bottom: 0;
            position: relative;
        }

        .doc-header::after {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            bottom: -6px;
            height: 2px;
            background: var(--color-accent);
        }

        .doc-header .doc-seal {
            height: 68px;
            width: auto;
            flex: none;
            object-fit: contain;
        }

        .doc-header .doc-title-block {
            display: flex;
            gap: 16px;
            align-items: center;
        }

        .doc-header .doc-org {
            margin: 0;
            font-size: 0.82rem;
            color: var(--color-text-muted);
            text-transform: uppercase;
            letter-spacing: 0.8px;
            font-weight: 700;
        }

        .doc-header h2 {
            margin: 4px 0 0;
            color: var(--color-primary);
            font-size: 1.45rem;
            font-weight: 700;
        }

        .doc-header .doc-meta {
            text-align: right;
            font-size: 0.92rem;
            color: var(--color-text-muted);
            white-space: nowrap;
            background: var(--color-bg);
            border: 1px solid var(--color-border);
            border-radius: var(--radius);
            padding: 8px 16px;
            line-height: 1.5;
        }

        .doc-header .doc-meta strong {
            color: var(--color-primary);
            font-size: 1.05rem;
        }

        .doc-subheader {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 16px 0 14px;
            padding: 6px 12px;
            background: var(--color-bg);
            border-left: 3px solid var(--color-accent);
            border-radius: 0 4px 4px 0;
            font-size: 0.78rem;
            color: var(--color-text-muted);
        }

        .doc-subheader span:last-child {
            font-weight: 700;
            color: var(--color-primary);
        }

        table.cases.doc-table {
            font-size: 0.88rem;
        }

        table.cases.doc-table th,
        table.cases.doc-table td {
            padding: 6px 10px;
        }

        table.cases.doc-table th:first-child,
        table.cases.doc-table td:first-child {
            width: 28px;
            text-align: center;
            color: var(--color-text-muted);
        }

        table.cases.doc-table th:nth-child(2),
        table.cases.doc-table td:nth-child(2) {
            text-align: left;
        }

        .doc-empty {
            padding: 20px;
            text-align: center;
            color: var(--color-text-muted);
            font-size: 0.82rem;
        }

        .doc-count {
            margin: 10px 2px 0;
            font-size: 0.75rem;
            color: var(--color-text-muted);
        }

        .doc-signoff {
            display: flex;
            justify-content: space-around;
            margin-top: 40px;
            padding-top: 6px;
        }

        .doc-signoff div {
            text-align: center;
            font-size: 0.78rem;
            color: var(--color-text-muted);
            width: 220px;
        }

        .doc-signoff .sig-line {
            border-top: 1px solid var(--color-text);
            margin-bottom: 5px;
            padding-top: 3px;
        }

        @@media print {
            header.app-header, .app-header, .app-subnav, .no-print, form, .feedback-banner {
                display: none !important;
            }
            body { background: #fff !important; color: #000 !important; margin: 0 !important; padding: 0 !important; }
            main { padding: 0 !important; margin: 0 !important; max-width: none !important; width: 100% !important; }
            .card { border: none !important; box-shadow: none !important; background: transparent !important; padding: 0 !important; margin: 0 !important; }
            .doc-sheet { background: #fff !important; padding: 0 !important; }
            .doc-header { border-bottom: 3px solid #000 !important; padding-bottom: 14px !important; }
            .doc-header .doc-seal { height: 72px !important; }
            .doc-header .doc-org { font-size: 0.85rem !important; color: #444 !important; }
            .doc-header h2 { font-size: 1.5rem !important; color: #000 !important; }
            .doc-header .doc-meta { font-size: 0.95rem !important; border: 1px solid #777 !important; background: #fff !important; color: #333 !important; }
            .doc-header .doc-meta strong { font-size: 1.1rem !important; color: #000 !important; }
            table.cases { width: 100% !important; font-size: 0.88rem !important; }
            table.cases th {
                background: #eef2f6 !important;
                color: #000 !important;
                font-size: 0.88rem !important;
                padding: 6px 8px !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
            table.cases td {
                border: 1px solid #888 !important;
                color: #000 !important;
                font-size: 0.88rem !important;
                padding: 6px 8px !important;
            }
            .doc-signoff { break-inside: avoid; }
            tbody tr { break-inside: avoid; }
        }
    </style>
    <style id="page-size-style">
        @@page {
            size: A4;
            margin: 12mm;
        }
    </style>
</head>
<body>
    <header class="app-header no-print">
        <div class="brand">
            CambioDeDomicilio
            <small>Municipalidad de Valparaíso — Documento F8 por sector</small>
        </div>
        <nav class="app-nav">
            <a asp-page="/SectorF8" asp-route-sector="Archivo" class="@(Model.SelectedSector == CambioDeDomicilio.Domain.FolderSector.Archivo ? "active" : "")"><partial name="_NavIcon" model="@("pdf")" /><span>PDF Archivo</span></a>
            <a asp-page="/SectorF8" asp-route-sector="Oficina43" class="@(Model.SelectedSector == CambioDeDomicilio.Domain.FolderSector.Oficina43 ? "active" : "")"><partial name="_NavIcon" model="@("pdf")" /><span>PDF Oficina 43</span></a>
        </nav>
    </header>
    <div class="app-subnav no-print">
        <span class="app-subnav-label">Otros sistemas</span>
        <a asp-page="/Index" class="nav-casos"><partial name="_NavIcon" model="@("home")" /><span>Cambio de Domicilio</span></a>
        <a asp-page="/F8" class="nav-f8"><partial name="_NavIcon" model="@("f8")" /><span>F8</span></a>
        <a asp-page="/SinCarpetas" class="nav-sin-carpetas"><partial name="_NavIcon" model="@("sin-carpetas")" /><span>Sin Carpetas</span></a>
    </div>

    <main>
        <form id="mark-printed-form" method="post" asp-page-handler="MarkPrinted" asp-route-sector="@Model.SelectedSector" style="display:none;"></form>
        <div class="no-print" style="margin-bottom: 14px; display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
            <button type="button" class="btn-primary" onclick="markPrintedAndPrint()">Imprimir / Guardar como PDF</button>
            <form method="post" asp-page-handler="ClearAll" asp-route-sector="@Model.SelectedSector"
                  onsubmit="return confirm('Esto vacía el listado de este sector — quedará en blanco para volver a llenarse con nuevos casos. NO elimina los datos de los contribuyentes, solo los saca de esta lista. ¿Confirmar?');">
                <button type="submit" class="btn-outline-danger">Vaciar listado</button>
            </form>
            <span style="display:flex; gap:6px; align-items:center; margin-left:8px;">
                <label class="form-label" for="page-size-select" style="margin:0;">Tamaño de hoja</label>
                <select id="page-size-select" onchange="updatePageSize()"
                        style="border:1px solid var(--color-border); border-radius:4px; padding:5px 8px; font-size:0.85rem;">
                    <option value="A4">A4</option>
                    <option value="letter">Carta</option>
                    <option value="legal">Oficio</option>
                </select>
            </span>
            <span style="font-size:0.8rem; color:var(--color-text-muted);">
                Este listado muestra solo los nombres marcados (checkbox "Marcar") entre los casos ya traspasados a F8.
            </span>
        </div>

        <div class="doc-sheet">
            <div class="doc-header">
                <div class="doc-title-block">
                    <img src="~/images/logo-municipalidad.png" alt="Municipalidad de Valparaíso" class="doc-seal" />
                    <div>
                        <p class="doc-org">Municipalidad de Valparaíso — Dirección de Tránsito</p>
                        <h2>F8 — Listado de carpetas — Sector @Model.SelectedSector.ToDisplayName()</h2>
                    </div>
                </div>
                <div class="doc-meta">
                    <div>Folio: <strong>F8-@Model.SelectedSector-@DateTimeOffset.Now.ToString("yyyyMMdd-HHmm")</strong></div>
                    <div>Generado: <strong>@DateTimeOffset.Now.ToString("dd-MM-yyyy HH:mm")</strong></div>
                </div>
            </div>
            <div class="doc-subheader">
                <span>Casos F8 — carpetas físicas a retirar</span>
                <span>@Model.Cases.Count registro(s)</span>
            </div>

            <div class="card">
                @if (Model.Cases.Count == 0)
                {
                    <p class="doc-empty">
                        No hay carpetas en este sector todavía. Marca el checkbox "Marcar" de los
                        casos correspondientes en la pantalla F8 (con su "Fecha penúltima carpeta"
                        ya ingresada) para que aparezcan aquí.
                    </p>
                }
                else
                {
                    <table class="cases doc-table">
                        <thead>
                            <tr>
                                <th>N°</th>
                                <th style="text-align:left;">Nombre completo</th>
                                <th>RUT</th>
                                <th>Comuna</th>
                                <th>Fecha penúltima carpeta</th>
                            </tr>
                        </thead>
                        <tbody>
                        @{ var correlativo = 0; }
                        @foreach (var item in Model.Cases)
                        {
                            correlativo++;
                            <tr>
                                <td>@correlativo</td>
                                <td style="text-align:left;">@item.FullName</td>
                                <td style="text-align:center;">@item.Rut</td>
                                <td style="text-align:center;">@item.Comuna</td>
                                <td style="text-align:center;">@(item.FechaUltimaCarpeta is { } f ? CambioDeDomicilio.Domain.SpanishDate.Format(f) : "")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </div>

            @if (Model.Cases.Count > 0)
            {
                <p class="doc-count">Total: @Model.Cases.Count carpeta(s)</p>

                <div class="doc-signoff">
                    <div>
                        <p class="sig-line">&nbsp;</p>
                        Quien solicita
                    </div>
                </div>
            }
        </div>
    </main>
    <script>
        function updatePageSize() {
            var size = document.getElementById('page-size-select').value;
            document.getElementById('page-size-style').textContent =
                '@@page { size: ' + size + '; margin: 12mm; }';
        }

        function markPrintedAndPrint() {
            var form = document.getElementById('mark-printed-form');
            var token = form.querySelector('input[name="__RequestVerificationToken"]').value;
            fetch(form.action, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: '__RequestVerificationToken=' + encodeURIComponent(token)
            }).finally(function () {
                window.print();
            });
        }
    </script>
    <script src="~/js/scroll-preserve.js" asp-append-version="true"></script>
    <partial name="_AuthorFooter" />
</body>
</html>
