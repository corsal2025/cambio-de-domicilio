                                <div style="font-weight:700; color:#0f172a;">Listado de Retiro para Archivo (Bodega)</div>
                                <span class="badge" style="background:#e2e8f0; color:#334155; font-size:0.7rem; padding:2px 6px;">Sector Archivo</span>
                            </div>
                            <div style="border:1px dashed #cbd5e1; border-radius:6px; padding:10px; background:#f8fafc; font-family:monospace; font-size:0.75rem;">
                                <div>========================================</div>
                                <div>MUNICIPALIDAD DE VALPARAISO - DIRECCION DE TRANSITO</div>
                                <div>NOMINA DE BUSQUEDA EN ARCHIVO FISICO</div>
                                <div>Fecha: 05/10/2026 • Operador: Ventanilla 2</div>
                                <div>========================================</div>
                                <div>1. 14.502.812-4 | PEREZ JUAN | Fecha: 12/03/2019</div>
                                <div>2. 16.891.024-9 | SOTO MARIA | Fecha: 28/05/2021</div>
                            </div>
                        </div>
                    `;
                }
            }
        ];

        let currentStepIndex = 0;
        let autoPlayInterval = null;

        function goToStep(stepNumber) {
            currentStepIndex = stepNumber - 1;
            renderCurrentStep();
        }

        function nextStep() {
            if (currentStepIndex < tourSteps.length - 1) {
                currentStepIndex++;
                renderCurrentStep();
            }
        }

        function prevStep() {
            if (currentStepIndex > 0) {
                currentStepIndex--;
                renderCurrentStep();
            }
        }

        function renderCurrentStep() {
            const data = tourSteps[currentStepIndex];

            // Update Progress Fill
            const percent = ((currentStepIndex + 1) / tourSteps.length) * 100;
            document.getElementById('tour-progress-fill').style.width = percent + '%';

            // Update Stepper Buttons
            const buttons = document.querySelectorAll('.tour-step-btn');
            buttons.forEach((btn, idx) => {
                if (idx === currentStepIndex) {
                    btn.classList.add('active');
                } else {
                    btn.classList.remove('active');
                }
            });

            // Update Controls
            document.getElementById('tour-btn-prev').disabled = currentStepIndex === 0;
            document.getElementById('tour-btn-next').disabled = currentStepIndex === tourSteps.length - 1;
            document.getElementById('tour-step-indicator').innerHTML = `
                <span>Paso ${data.step} de ${tourSteps.length}</span>
                <span style="color:#94a3b8;">•</span>
                <span style="color:#0284c7;">${data.title}</span>
            `;

            // Update Left Panel
            const badge = document.getElementById('tour-badge-tag');
            badge.innerText = data.tag;
            badge.style.background = data.badgeBg;
            badge.style.color = data.badgeColor;

            document.getElementById('tour-info-title').innerText = data.title;
            document.getElementById('tour-info-desc').innerHTML = data.desc;
            document.getElementById('tour-action-list').innerHTML = data.actionsHtml;
            document.getElementById('tour-golden-rule').innerHTML = data.goldenRule;

            const realLink = document.getElementById('tour-real-link');
            realLink.href = data.url;
            realLink.innerHTML = `<span>${data.realLinkText}</span>`;

            // Update Right Panel Simulation
            document.getElementById('sim-url-bar').innerHTML = `<span>🔒 ${data.url}</span>`;
            document.getElementById('sim-content').innerHTML = data.renderSim();
            document.getElementById('sim-toast').style.display = 'none';
        }

        function showToast(msg) {
            const toast = document.getElementById('sim-toast');
            toast.innerText = msg;
            toast.style.display = 'block';
            setTimeout(() => {
                toast.style.display = 'none';
            }, 4000);
        }

        function simulateAction(type) {
            if (type === 'marcar-subida') {
                const row = document.getElementById('sim-row-1');
                if (row) {
                    row.style.background = '#dcfce7';
                    row.style.transition = 'all 0.5s ease';
                    showToast('✅ ¡Solicitud subida a Conaset! El caso desaparece de Cambio de Domicilio y pasa a Subidas a Sistema.');
                    setTimeout(() => {
                        row.style.opacity = '0.3';
                        row.style.transform = 'translateX(20px)';
                    }, 600);
                }
            } else if (type === 'traspaso-f8') {
                showToast('📁 Caso trasladado a F8 para búsqueda de urgencia.');
            } else if (type === 'f8-caja') {
                const row = document.getElementById('sim-row-f8');
                if (row) row.style.opacity = '0.4';
                showToast('📦 ¡Carpeta apareció! Enviada a la cola de Caja para embalaje.');
            } else if (type === 'f8-sincarpeta') {
                const row = document.getElementById('sim-row-f8');
                if (row) row.style.opacity = '0.4';
                showToast('🗂️ Caso cerrado sin carpeta. Se archiva en la sección Sin Carpetas.');
            } else if (type === 'subidas-caja') {
                const row = document.getElementById('sim-row-subidas');
                if (row) row.style.opacity = '0.4';
                showToast('📦 ¡Carpeta en mano! Derivada exitosamente a la cola de Caja.');
            } else if (type === 'subidas-sincarpeta') {
                const row = document.getElementById('sim-row-subidas');
                if (row) row.style.opacity = '0.4';
                showToast('🗂️ Trámite sin papel. Archivado en Sin Carpetas.');
            } else if (type === 'subidas-rectificar') {
                showToast('🛡️ Correo de anulación enviado a la comuna. Caso revertido a Pendiente.');
            } else if (type === 'sincarpeta-revertir') {
                showToast('↩️ Caso reincorporado. Vuelve a la cola de Caja.');
            } else if (type === 'caja-cerrar') {
                document.getElementById('sim-box-result').innerHTML = `
                    <div style="background:#dcfce7; color:#15803d; padding:8px; border-radius:4px; font-weight:700;">
                        ✅ ¡Caja CAJA-008 cerrada con éxito! Rótulo oficial listo para imprimir.
                    </div>
                `;
                showToast('📦 Caja cerrada y foliada. Código CAJA-008 asignado.');
            }
        }

        function toggleAutoPlay() {
            const btn = document.getElementById('tour-btn-autoplay');
            if (autoPlayInterval) {
                clearInterval(autoPlayInterval);
                autoPlayInterval = null;
                btn.classList.remove('playing');
                btn.innerHTML = '<span>▶ Auto-Play</span>';
            } else {
                btn.classList.add('playing');
                btn.innerHTML = '<span>⏸ Pausar</span>';
                autoPlayInterval = setInterval(() => {
                    if (currentStepIndex < tourSteps.length - 1) {
                        nextStep();
                    } else {
                        goToStep(1);
                    }
                }, 5500);
            }
        }

        function startGuidedTour() {
            goToStep(1);
            document.getElementById('tour-interactivo').scrollIntoView({ behavior: 'smooth' });
            if (!autoPlayInterval) toggleAutoPlay();
        }

        // Initialize on load
        document.addEventListener('DOMContentLoaded', () => {
            renderCurrentStep();
        });
    </script>
</body>
</html>
