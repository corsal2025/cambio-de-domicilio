@page
@model CambioDeDomicilio.Dashboard.Pages.DiscardedModel
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Correos descartados — CambioDeDomicilio</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <div class="brand">
            CambioDeDomicilio
            <small>Municipalidad de Valparaíso — Correos descartados</small>
        </div>
        <nav class="app-nav">
            <a asp-page="/Index" class="nav-casos">Cambio de Domicilio</a>
            <a asp-page="/Comunas">Comunas</a>
            <a asp-page="/Discarded" class="active">Descartados</a>
            <a asp-page="/ChangePassword">Cambiar contraseña</a>
            <form asp-page="/Logout" method="post"><button type="submit">Salir</button></form>
        </nav>
    </header>
    <div class="app-subnav">
        <span class="app-subnav-label">Otros sistemas</span>
        <a asp-page="/F8" class="nav-f8">F8</a>
        <a asp-page="/Certificado" class="nav-certificado">Certificado</a>
        <a asp-page="/Estadisticas" class="nav-estadisticas">Estadísticas</a>
    </div>

    <main>
        <p class="review-hint">
            Correos encontrados en "CARP. PARA PEDIR" cuyo dominio de remitente no está en el directorio de comunas.
            Si falta una comuna, agréguela en la pantalla de Comunas — el próximo ciclo dejará de descartar sus correos.
        </p>

        @if (Model.Items.Count > 0)
        {
            <form method="post" asp-page-handler="DeleteAll" style="margin-bottom: 14px;"
                  onsubmit="return confirm('Esto elimina TODOS los correos descartados de la lista de forma permanente. ¿Confirmar?');">
                <button type="submit" class="btn-outline-danger">Eliminar todos</button>
            </form>
        }

        <div class="card">
            <table class="cases">
                <thead>
                    <tr>
                        <th>Remitente</th>
                        <th>Asunto</th>
                        <th>Motivo</th>
                        <th>Descartado</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.SourceSender</td>
                        <td>@item.SourceSubject</td>
                        <td>@item.Reason</td>
                        <td>@item.DiscardedAt.LocalDateTime.ToString("dd-MM-yyyy HH:mm")</td>
                        <td style="text-align:center;">
                            <form method="post" asp-page-handler="Delete"
                                  onsubmit="return confirm('Esto elimina este correo descartado de forma permanente. ¿Confirmar?');">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn-danger" title="Eliminar" aria-label="Eliminar">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M3 6h18" />
                                        <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                                        <line x1="10" y1="11" x2="10" y2="17" />
                                        <line x1="14" y1="11" x2="14" y2="17" />
                                    </svg>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </main>
    <script src="~/js/scroll-preserve.js" asp-append-version="true"></script>
</body>
</html>
