@page
@model CambioDeDomicilio.Dashboard.Pages.DiscardedModel
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Correos descartados — CambioDeDomicilio</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <div class="brand">
            <img src="~/images/logo-municipalidad.png" alt="Municipalidad de Valparaíso" class="brand-logo" />
            <span>
                CambioDeDomicilio
                <small>Municipalidad de Valparaíso</small>
                <small>Correos descartados</small>
            </span>
        </div>
        <nav class="app-nav">
            <button type="button" id="btn-guia-global" class="btn-guia-accion" title="Cómo usar el sistema (Guía interactiva)" data-tooltip="Simulador interactivo con flecha explicativa que te enseña paso a paso cómo usar el sistema">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                <span>Cómo usar el sistema</span>
            </button>
            <div class="nav-group">
                <a asp-page="/Index"><partial name="_NavIcon" model="@("back")" /><span>Volver a Casos</span></a>
                <a asp-page="/Comunas"><partial name="_NavIcon" model="@("map")" /><span>Comunas</span></a>
                <a asp-page="/Discarded" class="active"><partial name="_NavIcon" model="@("discarded")" /><span>Descartados</span></a>
            </div>
        </nav>
    </header>
    <div class="app-subnav">
        <div class="app-subnav-main">
            <span class="app-subnav-label">Sistemas</span>
            <a asp-page="/Index" class="nav-casos"><partial name="_NavIcon" model="@("home")" /><span>Cambio de Domicilio</span></a>
            <a asp-page="/F8" class="nav-f8"><partial name="_NavIcon" model="@("f8")" /><span>F8</span></a>
            <a asp-page="/SubidasASistema" class="nav-subidas"><partial name="_NavIcon" model="@("upload")" /><span>Subidas a Sistema</span></a>
            <a asp-page="/SinCarpetas" class="nav-sin-carpetas"><partial name="_NavIcon" model="@("sin-carpetas")" /><span>Sin Carpetas</span></a>
            <a asp-page="/Caja" class="nav-caja"><partial name="_NavIcon" model="@("caja")" /><span>Caja</span></a>
            <a asp-page="/Estadisticas" class="nav-estadisticas"><partial name="_NavIcon" model="@("stats")" /><span>Estadísticas</span></a>
        </div>
        <div class="app-subnav-docs">
            <span class="app-subnav-label">Documentos</span>
            <a asp-page="/Sector" asp-route-sector="Archivo" class="nav-pdf-archivo" title="Generar listado para Archivo">
                <partial name="_NavIcon" model="@("pdf")" /><span>PDF Archivo</span>
            </a>
            <a asp-page="/Sector" asp-route-sector="Oficina43" class="nav-pdf-oficina43" title="Generar listado para Oficina 43">
                <partial name="_NavIcon" model="@("pdf")" /><span>PDF Oficina 43</span>
            </a>
        </div>
    </div>

    <main>
        <p class="review-hint">
            Correos encontrados en "CARP. PARA PEDIR" cuyo dominio de remitente no está en el directorio de comunas.
            Si falta una comuna, agréguela en la pantalla de Comunas — el próximo ciclo dejará de descartar sus correos.
        </p>

        @if (Model.Items.Count > 0)
        {
            <div class="action-bar">
                <form method="post" asp-page-handler="DeleteAll"
                      onsubmit="return confirm('Esto elimina TODOS los correos descartados de la lista de forma permanente. ¿Confirmar?');">
                    <button type="submit" class="btn-outline-danger">Eliminar todos</button>
                </form>
            </div>
        }

        <div class="card">
            <table class="cases">
                <thead>
                    <tr>
                        <th>Remitente</th>
                        <th>Asunto</th>
                        <th>Motivo</th>
                        <th>Descartado</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.SourceSender</td>
                        <td>@item.SourceSubject</td>
                        <td>@item.Reason</td>
                        <td>@item.DiscardedAt.LocalDateTime.ToString("dd-MM-yyyy HH:mm")</td>
                        <td style="text-align:center;">
                            <form method="post" asp-page-handler="Delete"
                                  onsubmit="return confirm('Esto elimina este correo descartado de forma permanente. ¿Confirmar?');">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn-danger" title="Eliminar" aria-label="Eliminar">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M3 6h18" />
                                        <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                                        <line x1="10" y1="11" x2="10" y2="17" />
                                        <line x1="14" y1="11" x2="14" y2="17" />
                                    </svg>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </main>
    <script src="~/js/scroll-preserve.js" asp-append-version="true"></script>
    <partial name="_AuthorFooter" />
    <script src="~/js/system-tour.js" asp-append-version="true"></script>
</body>
</html>
