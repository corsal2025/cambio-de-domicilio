@page
@model CambioDeDomicilio.Dashboard.Pages.ResetPasswordModel
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Restablecer contraseña — CambioDeDomicilio</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>
    <div class="login-shell">
        <div class="login-card">
            <h1>CambioDeDomicilio</h1>
            <p class="subtitle">Elegir nueva contraseña</p>

            @if (Model.Message is not null)
            {
                <p class="@(Model.MessageIsError ? "error" : "message-banner")">@Model.Message</p>
            }

            @if (!Model.Completed)
            {
                <form method="post">
                    <input type="hidden" asp-for="Token" />
                    <input asp-for="NewPassword" type="password" placeholder="Nueva contraseña" autofocus />
                    <input asp-for="ConfirmPassword" type="password" placeholder="Confirmar nueva contraseña" />
                    <button type="submit">Restablecer contraseña</button>
                </form>
            }
            <p class="subtitle" style="margin-top: 16px;"><a asp-page="/Login">Volver a ingresar</a></p>
        </div>
    </div>
</body>
</html>
