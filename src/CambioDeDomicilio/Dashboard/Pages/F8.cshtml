@page
@model CambioDeDomicilio.Dashboard.Pages.F8Model
@using CambioDeDomicilio.Domain
<!DOCTYPE html>
<html lang="es" class="cases-page-html">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>F8 — CambioDeDomicilio</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body class="cases-page">
    <header class="app-header">
        <div class="brand">
            <img src="~/images/logo-municipalidad.png" alt="Municipalidad de Valparaíso" class="brand-logo" />
            <span>
                CambioDeDomicilio
                <small>Municipalidad de Valparaíso</small>
                <small>Casos F8</small>
            </span>
        </div>
        <nav class="app-nav">
            <div class="nav-group nav-group-filters">
                <a asp-page="/Index" class="nav-casos"><partial name="_NavIcon" model="@("back")" /><span>Volver a Cambio de Domicilio</span></a>
            </div>
            <div class="nav-group nav-group-end">
                <form method="get" class="nav-search">
                    <input type="text" name="search" id="search-input" placeholder="Buscar por RUT o nombre..." value="@Model.Search" data-had-value="@(!string.IsNullOrEmpty(Model.Search) ? "true" : "false")" oninput="formatSearchRut(this); clearSearchIfEmpty(this)" />
                    <button type="submit" class="nav-pill"><partial name="_NavIcon" model="@("search")" /><span>Buscar</span></button>
                    @if (!string.IsNullOrEmpty(Model.Search))
                    {
                        <a asp-page="/F8" class="nav-search-clear"><partial name="_NavIcon" model="@("clear")" /><span>Limpiar</span></a>
                    }
                </form>
            </div>
        </nav>
    </header>
    <div class="app-subnav">
        <div class="app-subnav-main">
            <span class="app-subnav-label">Sistemas</span>
            <a asp-page="/Index" class="nav-casos"><partial name="_NavIcon" model="@("home")" /><span>Cambio de Domicilio</span></a>
            <a asp-page="/F8" class="nav-f8 active"><partial name="_NavIcon" model="@("f8")" /><span>F8</span></a>
            <a asp-page="/Caja" class="nav-caja"><partial name="_NavIcon" model="@("caja")" /><span>Caja</span></a>
            <a asp-page="/Estadisticas" class="nav-estadisticas"><partial name="_NavIcon" model="@("stats")" /><span>Estadísticas</span></a>
        </div>
        <div class="app-subnav-docs">
            <span class="app-subnav-label">Documentos F8</span>
            <a asp-page="/SectorF8" asp-route-sector="Archivo" class="nav-pdf-archivo" title="Generar listado F8 para Archivo">
                <partial name="_NavIcon" model="@("pdf")" /><span>PDF Archivo</span>
            </a>
            <a asp-page="/SectorF8" asp-route-sector="Oficina43" class="nav-pdf-oficina43" title="Generar listado F8 para Oficina 43">
                <partial name="_NavIcon" model="@("pdf")" /><span>PDF Oficina 43</span>
            </a>
        </div>
    </div>

    <main>
        @if (Model.Message is not null)
        {
            <p class="message-banner @(Model.MessageIsError ? "message-error" : "")">@Model.Message</p>
        }

                @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <div class="f8-search-active-banner">
                <div style="display:flex; align-items:center; gap:8px;">
                    <span style="font-size:1.3rem;">🎯</span>
                    <span>Filtrando por <strong>"@Model.Search"</strong>: @(Model.Cases.Count == 0 ? "No se encontraron casos" : $"Se encontró {Model.Cases.Count} caso(s)")</span>
                </div>
                <a asp-page="/F8" class="btn-clear-f8-filter">✕ Mostrar todos los casos F8 (@Model.TotalF8Count)</a>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Search) && Model.CasosMatchCount > 0)
        {
            <div class="cross-search-banner cross-search-banner-info">
                <span class="cross-search-icon">ℹ️</span>
                <div class="cross-search-text">
                    Esta persona tiene <strong>@Model.CasosMatchCount caso(s)</strong> registrado(s) en <strong>Cambio de Domicilio</strong>.
                </div>
                <a asp-page="/Index" asp-route-search="@Model.Search" class="btn-cross-search">
                    Ver en Cambio de Domicilio &rarr;
                </a>
            </div>
        }

        <div class="card table-card">
            <table class="cases cases-index cases-f8">
                <thead>
                    <tr class="header-groups">
                        <th colspan="2" class="th-group th-group-frozen th-group-1 th-group-frozen-end">Contribuyente</th>
                        <th colspan="2" class="th-group">Marcado</th>
                        <th class="th-group">Destino</th>
                        <th colspan="3" class="th-group">Plazos y Estado</th>
                        <th colspan="3" class="th-group">Carpeta física</th>
                        <th class="th-group">Acción</th>
                    </tr>
                    <tr class="header-cols">
                        <th>Nombre</th>
                        <th>RUT</th>
                        <th title="Selecciona los casos que deben incluirse en el próximo PDF Archivo/Oficina 43">Marcar</th>
                        <th title="Marca la carpeta como pendiente de retiro — resalta la fila en morado">Pendiente<br />Carpeta</th>
                        <th>Comuna</th>
                        <th>Recibido</th>
                        <th>Plazo<br /><span class="th-subtext">(15 días hábiles)</span></th>
                        <th>Estado</th>
                        <th>Código<br />F8</th>
                        <th>Fecha penúltima<br />Carpeta</th>
                        <th>Sector</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Cases)
                {
                    var statusRowClass = item.NeedsReview
                        ? "row-needs-review"
                        : (item.IsActionCompleted ? "row-done" : "");
                    var markedClass = item.Marked ? "row-marked" : "";
                    var pendienteCarpetaClass = item.PendienteCarpeta ? "row-pendiente-carpeta" : "";
                    var bouncedClass = item.ConfirmationBouncedAt is not null ? "row-bounced" : "";
                    var isTarget = (Model.HighlightId.HasValue && item.Id == Model.HighlightId.Value) ||
                                   (!string.IsNullOrWhiteSpace(Model.Search) && Model.Cases.Count == 1);
                    var targetClass = isTarget ? "row-highlight-target" : "";
                    <tr class="@statusRowClass @markedClass @pendienteCarpetaClass @bouncedClass @targetClass" id="case-row-@item.Id">
                        <td class="name-cell">
                            <form method="post" asp-page-handler="SetPersonData" id="person-form-@item.Id">
                                <input type="hidden" name="id" value="@item.Id" />
                            </form>
                            <span class="name-with-alert">
                            @if (isTarget)
                            {
                                <span class="badge-f8-target" title="Caso seleccionado desde la búsqueda">📍 CASO BUSCADO</span>
                            }
                            @if (item.NeedsReview)
                            {
                                <span class="review-alert" aria-label="Requiere revisión"
                                      title="Requiere revisión — datos no extraíbles del correo (asunto: @item.SourceSubject)">⚠️</span>
                            }
                            <input type="text" name="nombre" value="@item.FullName" placeholder="Nombre completo" required
                                   size="@Math.Max((item.FullName?.Length ?? 0) + 2, 12)"
                                   class="input-inline name-input" form="person-form-@item.Id" onchange="savePersonFieldIfDoneEditing(this)"
                                   title="@(item.NeedsReview ? $"Requiere revisión — datos no extraíbles del correo (asunto: {item.SourceSubject})" : item.FullName)" />
                            </span>
                        </td>
                        <td class="text-cell rut-cell">
                            <input type="text" name="rut" value="@item.Rut" placeholder="RUT" required size="13"
                                   class="input-inline rut-input" form="person-form-@item.Id" onchange="savePersonFieldIfDoneEditing(this)"
                                   oncopy="var s=this.value.substring(this.selectionStart,this.selectionEnd)||this.value; event.clipboardData.setData('text/plain', s.replace(/\./g,'')); event.preventDefault();" />
                        </td>
                        <td class="marked-cell">
                            <form method="post" asp-page-handler="ToggleMarked" class="marked-form">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="checkbox" name="markedValue" class="marked-checkbox"
                                       @(item.Marked ? "checked" : "") onchange="toggleMutuallyExclusive(this, 'markedValue', 'pendienteCarpetaValue')"
                                       title="@(item.Marked ? "Desmarcar caso" : "Marcar caso")" />
                            </form>
                        </td>
                        <td class="marked-cell">
                            <form method="post" asp-page-handler="TogglePendienteCarpeta" class="marked-form">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="checkbox" name="pendienteCarpetaValue" class="marked-checkbox"
                                       @(item.PendienteCarpeta ? "checked" : "") onchange="toggleMutuallyExclusive(this, 'pendienteCarpetaValue', 'markedValue')"
                                       title="@(item.PendienteCarpeta ? "Desmarcar pendiente carpeta" : "Marcar pendiente carpeta")" />
                            </form>
                        </td>
                        <td class="text-cell">@item.Comuna</td>
                        <td class="text-cell">@item.ReceivedAt.LocalDateTime.ToString("dd-MM-yyyy")</td>
                        <td>
                            @if (item.Status == RequestStatus.Pending)
                            {
                                var restantes = Model.DiasHabilesRestantes(item);
                                var plazoClass = restantes <= 3 ? "badge-review" : restantes <= 7 ? "badge-uploaded" : "badge-ok";
                                var plazoText = restantes < 0
                                    ? $"VENCIDO hace {-restantes} días"
                                    : $"quedan {restantes} días";
                                <span class="badge @plazoClass">@plazoText</span>
                            }
                            else
                            {
                                <span class="badge badge-confirmed">cumplido</span>
                            }
                        </td>
                        <td>
                            @{
                                var (badgeClass, badgeText) = item.Status switch
                                {
                                    RequestStatus.Pending => ("badge-pending", "Pendiente"),
                                    RequestStatus.Uploaded => ("badge-uploaded", "Subido"),
                                    RequestStatus.Confirmed => ("badge-confirmed", "Confirmado"),
                                    _ => ("badge-pending", item.Status.ToString())
                                };
                            }
                            <span class="badge @badgeClass">@badgeText</span>
                            @if (item.ConfirmationBouncedAt is { } bouncedAt)
                            {
                                <span class="badge badge-bounced"
                                      title="La confirmación a la comuna rebotó el @bouncedAt.LocalDateTime.ToString("dd-MM-yyyy") — la comuna no la recibió">REBOTÓ</span>
                            }
                        </td>
                        <td>
                            <form method="post" asp-page-handler="SetCodigoF8" class="codigo-f8-form">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="text" name="codigoF8" class="input-inline codigo-f8-input" size="12"
                                       placeholder="ej: F8-1234"
                                       value="@item.CodigoF8"
                                       onchange="this.form.submit()" />
                            </form>
                        </td>
                        <td>
                            <form method="post" asp-page-handler="SetFecha" class="fecha-form">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="text" name="fecha" class="input-inline fecha-input" size="16"
                                       placeholder="ej: 15/03/2024 o S/C"
                                       title="Formatos aceptados: 15/03/2024, 15 marzo 2024, o S/C (sin carpeta)"
                                       value="@(item.SinCarpeta ? "S/C" : item.FechaUltimaCarpeta is { } f ? SpanishDate.Format(f) : "")"
                                       onchange="this.form.submit()" />
                            </form>
                        </td>
                        <td class="text-cell">@item.Sector.ToDisplayName()</td>
                        <td>
                            <div class="action-group">
                            @if (item.Status == RequestStatus.Pending && !item.NeedsReview)
                            {
                                <form method="post" asp-page-handler="MarkUploadedAndConfirm"
                                      onsubmit="return confirm('Esto moverá el correo a \'CARP. YA SUBIDAS\' y enviará la confirmación a la comuna de inmediato. ¿Confirmar?');">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="search" value="@Model.Search" />
                                    <input type="hidden" name="highlightId" value="@Model.HighlightId" />
                                    <button type="submit" class="btn-action btn-action--upload" title="Mover correo a 'CARP. YA SUBIDAS' y enviar confirmación" aria-label="Marcar subida">
                                        <partial name="_ActionIcon" model="@("upload")" /><span>Marcar subida</span>
                                    </button>
                                </form>
                            }
                            else if (item.Status == RequestStatus.Uploaded && !item.NeedsReview)
                            {
                                <form method="post" asp-page-handler="Confirm">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="search" value="@Model.Search" />
                                    <input type="hidden" name="highlightId" value="@Model.HighlightId" />
                                    <button type="submit" class="btn-action btn-action--confirm" title="Enviar confirmación a la comuna" aria-label="Confirmar">
                                        <partial name="_ActionIcon" model="@("confirm")" /><span>Confirmar</span>
                                    </button>
                                </form>
                            }
                                <form method="post" asp-page-handler="SendToCaja"
                                      onsubmit="return confirm('¿Carpeta física encontrada? El caso se enviará a la cola de Caja (no se enviará ningún correo).');">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="search" value="@Model.Search" />
                                    <input type="hidden" name="highlightId" value="@Model.HighlightId" />
                                    <button type="submit" class="btn-action btn-action--caja" title="Carpeta encontrada: enviar a la cola de Caja (sin enviar correo)" aria-label="Enviar a Caja">
                                        <partial name="_ActionIcon" model="@("caja")" /><span>Caja</span>
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="CloseWithoutFolder"
                                      onsubmit="return confirm('Esto cierra el proceso SIN carpeta. El caso vuelve a Casos como \'Cerrado sin carpeta\' y sin acciones. ¿Confirmar?');">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="search" value="@Model.Search" />
                                    <input type="hidden" name="highlightId" value="@Model.HighlightId" />
                                    <button type="submit" class="btn-action btn-action--sin-carpeta" title="Cerrar el proceso sin carpeta física" aria-label="Sin carpeta">
                                        <partial name="_ActionIcon" model="@("sin-carpeta")" /><span>Sin carpeta</span>
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="RevertToCasos"
                                      onsubmit="return confirm('Revertir borra TODOS los datos F8 de este caso (incluido el código F8) y lo devuelve a Casos solo con la acción Caja. No se puede deshacer. ¿Confirmar?');">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="search" value="@Model.Search" />
                                    <input type="hidden" name="highlightId" value="@Model.HighlightId" />
                                    <button type="submit" class="btn-action btn-action--revert" title="Borrar los datos F8 y devolver el caso a Casos para enviarlo a Caja" aria-label="Revertir F8">
                                        <partial name="_ActionIcon" model="@("revert")" /><span>Revertir</span>
                                    </button>
                                </form>
                            @if (item.ConfirmationBouncedAt is not null)
                            {
                                <form method="post" asp-page-handler="ResolveBounce"
                                      onsubmit="return confirm('Marca el rebote como resuelto (ya reenviaste la confirmación o lo gestionaste de otra forma). ¿Confirmar?');">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="search" value="@Model.Search" />
                                    <input type="hidden" name="highlightId" value="@Model.HighlightId" />
                                    <button type="submit" class="btn-action btn-action--resolve" title="Marcar el rebote de confirmación como resuelto" aria-label="Marcar resuelto">
                                        <partial name="_ActionIcon" model="@("resolve")" /><span>Resuelto</span>
                                    </button>
                                </form>
                            }
                            <form method="post" asp-page-handler="DeleteCase"
                                  onsubmit="return confirm('Esto elimina el caso de forma permanente, no se puede deshacer. ¿Confirmar?');">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn-action btn-action--delete" title="Eliminar caso permanentemente" aria-label="Eliminar caso">
                                    <partial name="_ActionIcon" model="@("delete")" />
                                </button>
                            </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </main>

    <script>
        // Same RUT auto-format and clear-on-empty behavior as the Casos search box.
        function formatSearchRut(input) {
            var raw = input.value;
            if (!/^\d+[kK]?$/.test(raw.replace(/[.\-]/g, ''))) {
                return;
            }

            var clean = raw.replace(/[.\-]/g, '');
            if (clean.length < 2) {
                return;
            }

            var body = clean.slice(0, -1);
            var dv = clean.slice(-1).toUpperCase();
            var formattedBody = body.replace(/\B(?=(\d{3})+(?!\d))/g, '.');

            input.value = formattedBody + '-' + dv;
        }

        function clearSearchIfEmpty(input) {
            if (input.value === '' && input.dataset.hadValue === 'true') {
                input.form.submit();
            }
            input.dataset.hadValue = input.value !== '' ? 'true' : 'false';
        }

        function toggleMutuallyExclusive(checkbox, thisName, otherName) {
            if (checkbox.checked) {
                var row = checkbox.closest('tr');
                var otherCheckbox = row.querySelector('input[name="' + otherName + '"]');
                if (otherCheckbox && otherCheckbox.checked) {
                    otherCheckbox.checked = false;
                    var otherForm = otherCheckbox.closest('form');
                    if (otherForm) otherForm.submit();
                }
            }
            var form = checkbox.closest('form');
            if (form) form.submit();
        }

        function savePersonFieldIfDoneEditing(input) {
            var form = input.form;
            if (!form) return;
            var tr = input.closest('tr');
            if (!tr) return;
            var nombreInput = tr.querySelector('input[name="nombre"]');
            var rutInput = tr.querySelector('input[name="rut"]');
            var nombreVal = (nombreInput ? nombreInput.value : '').trim();
            var rutVal = (rutInput ? rutInput.value : '').trim();
            if (nombreVal !== '' && rutVal !== '') {
                var hiddenNombre = form.querySelector('input[name="nombre"]');
                if (!hiddenNombre) {
                    hiddenNombre = document.createElement('input');
                    hiddenNombre.type = 'hidden';
                    hiddenNombre.name = 'nombre';
                    form.appendChild(hiddenNombre);
                }
                hiddenNombre.value = nombreVal;

                var hiddenRut = form.querySelector('input[name="rut"]');
                if (!hiddenRut) {
                    hiddenRut = document.createElement('input');
                    hiddenRut.type = 'hidden';
                    hiddenRut.name = 'rut';
                    form.appendChild(hiddenRut);
                }
                hiddenRut.value = rutVal;

                form.submit();
            }
        }
    </script>
    <script>
        (function () {
            var table = document.querySelector('table.cases-index');
            if (!table) return;

            var isF8 = table.classList.contains('cases-f8');
            var freezeCount = 2; // Nombre + RUT
            var headerCells = table.querySelectorAll('thead tr.header-cols > *');
            var groupRow = table.querySelector('thead tr.header-groups');

            function setFreezeOffsets() {
                var cumulative = 0;
                for (var i = 0; i < freezeCount && i < headerCells.length; i++) {
                    cumulative += headerCells[i].getBoundingClientRect().width;
                    if (i < freezeCount - 1) {
                        table.style.setProperty('--freeze-left-' + (i + 2), cumulative + 'px');
                    }
                }
                if (groupRow) {
                    table.style.setProperty('--header-row2-top', groupRow.getBoundingClientRect().height + 'px');
                }
            }

            setFreezeOffsets();

            if (document.fonts && document.fonts.ready) {
                document.fonts.ready.then(setFreezeOffsets);
            }

            if (window.ResizeObserver) {
                var ro = new ResizeObserver(setFreezeOffsets);
                ro.observe(table);
            } else {
                var resizeTimer = null;
                window.addEventListener('resize', function () {
                    clearTimeout(resizeTimer);
                    resizeTimer = setTimeout(setFreezeOffsets, 100);
                });
            }
        })();
    </script>
    <script>
        (function () {
            // After "load" (and a beat later) so fonts/layout are final and scroll-preserve.js,
            // which restores the previous scroll position, doesn't undo it.
            window.addEventListener('load', function () {
                setTimeout(function () {
                    var target = document.querySelector('tr.row-highlight-target');
                    if (target && !window.scrollPositionRestored) {
                        target.scrollIntoView({ block: 'center', inline: 'nearest' });
                    }
                }, 150);
            });
        })();
    </script>
    <script src="~/js/scroll-preserve.js" asp-append-version="true"></script>
    <partial name="_AuthorFooter" />
</body>
</html>
