@page
@model OutlookComunaRouter.Dashboard.Pages.LoginModel
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Ingresar — OutlookComunaRouter</title>
    <link rel="stylesheet" href="~/css/dashboard.css" />
</head>
<body>
    <div class="login-shell">
        <div class="login-card">
            <h1>OutlookComunaRouter</h1>
            <p class="subtitle">Municipalidad de Valparaíso — Solicitudes de carpeta</p>
            <form method="post">
                <input asp-for="Username" placeholder="Usuario" autofocus />
                <input asp-for="Password" type="password" placeholder="Contraseña" />
                <button type="submit">Ingresar</button>
                @if (Model.ErrorMessage is not null)
                {
                    <p class="error">@Model.ErrorMessage</p>
                }
            </form>
        </div>
    </div>
</body>
</html>
