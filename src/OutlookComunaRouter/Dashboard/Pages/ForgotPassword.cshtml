@page
@model OutlookComunaRouter.Dashboard.Pages.ForgotPasswordModel
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Olvidé mi contraseña — OutlookComunaRouter</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>
    <div class="login-shell">
        <div class="login-card">
            <h1>OutlookComunaRouter</h1>
            <p class="subtitle">Recuperar acceso al dashboard</p>
            @if (Model.Message is not null)
            {
                <p class="message-banner">@Model.Message</p>
            }
            else
            {
                <form method="post">
                    <input asp-for="Username" placeholder="Usuario" autofocus />
                    <button type="submit">Enviar enlace de recuperación</button>
                </form>
            }
            <p class="subtitle" style="margin-top: 16px;"><a asp-page="/Login">Volver a ingresar</a></p>
        </div>
    </div>
</body>
</html>
