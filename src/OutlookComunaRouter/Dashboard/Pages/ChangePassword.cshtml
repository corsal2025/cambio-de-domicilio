@page
@model OutlookComunaRouter.Dashboard.Pages.ChangePasswordModel
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Cambiar contraseña — OutlookComunaRouter</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <div class="brand">
            OutlookComunaRouter
            <small>Municipalidad de Valparaíso — Cambiar contraseña</small>
        </div>
        <nav class="app-nav">
            <a asp-page="/Index" class="nav-casos">Cambio de Domicilio</a>
            <a asp-page="/Comunas">Comunas</a>
            <a asp-page="/Discarded">Descartados</a>
            <a asp-page="/ChangePassword" class="active">Cambiar contraseña</a>
            <form asp-page="/Logout" method="post"><button type="submit">Salir</button></form>
        </nav>
    </header>

    <main>
        @if (Model.Message is not null)
        {
            <p class="message-banner @(Model.MessageIsError ? "message-error" : "")">@Model.Message</p>
        }

        <div class="card" style="max-width: 380px; padding: 24px;">
            <form method="post">
                <label class="form-label" for="current-password">Contraseña actual</label>
                <div class="password-field">
                    <input asp-for="CurrentPassword" type="password" id="current-password" class="input-block" autocomplete="current-password" />
                </div>

                <label class="form-label" for="new-password">Nueva contraseña</label>
                <div class="password-field">
                    <input asp-for="NewPassword" type="password" id="new-password" class="input-block" autocomplete="new-password" />
                </div>

                <label class="form-label" for="confirm-password">Confirmar nueva contraseña</label>
                <div class="password-field">
                    <input asp-for="ConfirmPassword" type="password" id="confirm-password" class="input-block" autocomplete="new-password" />
                </div>

                <button type="submit" class="btn-primary" style="width: 100%; margin-top: 8px; padding: 9px;">Actualizar contraseña</button>
            </form>
        </div>

        <div class="card" style="max-width: 380px; padding: 24px; margin-top: 16px;">
            <form method="post" asp-page-handler="UpdateEmail">
                <label class="form-label" for="recovery-email">Correo de recuperación</label>
                <input asp-for="Email" type="email" id="recovery-email" class="input-block" placeholder="tu.correo@munivalpo.cl" />
                <p class="review-hint">Se usa solo para enviarte un enlace si olvidas tu contraseña.</p>
                <button type="submit" class="btn-primary" style="width: 100%; margin-top: 8px; padding: 9px;">Guardar correo</button>
            </form>
        </div>

        <div class="card" style="max-width: 380px; padding: 24px; margin-top: 16px;">
            <form method="post" asp-page-handler="UpdateEmailFooter">
                <label class="form-label" for="email-footer">Pie de correo</label>
                <textarea asp-for="EmailFooter" id="email-footer" class="input-block" rows="4"
                          placeholder="Tu nombre&#10;Cargo&#10;Municipalidad de Valparaíso" style="resize: vertical;"></textarea>
                <p class="review-hint">Se agrega automáticamente al final de los correos de confirmación y rectificación que envíes a otras comunas.</p>
                <button type="submit" class="btn-primary" style="width: 100%; margin-top: 8px; padding: 9px;">Guardar pie de correo</button>
            </form>
        </div>
    </main>
</body>
</html>
