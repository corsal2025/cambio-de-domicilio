@page
@model OutlookComunaRouter.Dashboard.Pages.IndexModel
@using OutlookComunaRouter.Domain
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="120" />
    <title>Casos — OutlookComunaRouter</title>
    <link rel="stylesheet" href="~/css/dashboard.css" />
</head>
<body>
    <header class="app-header">
        <div class="brand">
            OutlookComunaRouter
            <small>Municipalidad de Valparaíso — Solicitudes de carpeta</small>
        </div>
        <nav class="app-nav">
            <a asp-page="/Index" class="@(Model.StatusFilter is null && !Model.OnlyNeedsReview ? "active" : "")">Todos</a>
            <a asp-page="/Index" asp-route-status="Pending" class="@(Model.StatusFilter == "Pending" ? "active" : "")">Pendientes</a>
            <a asp-page="/Index" asp-route-status="Uploaded" class="@(Model.StatusFilter == "Uploaded" ? "active" : "")">Subidos</a>
            <a asp-page="/Index" asp-route-status="Confirmed" class="@(Model.StatusFilter == "Confirmed" ? "active" : "")">Confirmados</a>
            <a asp-page="/Index" asp-route-needsReview="true" class="@(Model.OnlyNeedsReview ? "active" : "")">Requiere revisión</a>
            <a asp-page="/Sector" asp-route-sector="Archivo">PDF Archivo</a>
            <a asp-page="/Sector" asp-route-sector="Oficina43">PDF Oficina 43</a>
            <a asp-page="/Comunas">Comunas</a>
            <form asp-page="/Logout" method="post"><button type="submit">Salir</button></form>
        </nav>
    </header>

    <main>
        @if (Model.Message is not null)
        {
            <p class="message-banner">@Model.Message</p>
        }

        <div class="card">
            <table class="cases">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>RUT</th>
                        <th>Comuna</th>
                        <th>Estado</th>
                        <th>Fecha última carpeta</th>
                        <th>Sector</th>
                        <th>Requiere revisión</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Cases)
                {
                    <tr>
                        <td>@item.FullName</td>
                        <td>@item.Rut</td>
                        <td>@item.Comuna</td>
                        <td>
                            @{
                                var (badgeClass, badgeText) = item.Status switch
                                {
                                    RequestStatus.Pending => ("badge-pending", "Pendiente"),
                                    RequestStatus.Uploaded => ("badge-uploaded", "Subido"),
                                    RequestStatus.Confirmed => ("badge-confirmed", "Confirmado"),
                                    _ => ("badge-pending", item.Status.ToString())
                                };
                            }
                            <span class="badge @badgeClass">@badgeText</span>
                        </td>
                        <td>
                            <form method="post" asp-page-handler="SetFecha">
                                <input type="hidden" name="id" value="@item.Id" />
                                <input type="date" name="fecha" value="@item.FechaUltimaCarpeta?.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
                            </form>
                        </td>
                        <td>@(item.Sector?.ToString() ?? "—")</td>
                        <td>
                            @if (item.NeedsReview)
                            {
                                <span class="badge badge-review">Sí</span>
                            }
                            else
                            {
                                <text>No</text>
                            }
                        </td>
                        <td>
                            @if (item.Status == RequestStatus.Uploaded && !item.NeedsReview)
                            {
                                <form method="post" asp-page-handler="Confirm">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn-primary">Enviar confirmación</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </main>
</body>
</html>
