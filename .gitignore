.DS_Store
.worktrees/

# .NET
bin/
obj/
*.user

# Secrets / environment-specific config
src/OutlookComunaRouter/appsettings.Development.json
**/appsettings.Development.json
.env

# TLS certificate private key material (LAN self-signed cert)
certs/

# Runtime data (SQLite DB, reports, comuna directory with real contact emails)
# Double-starred so this applies at any depth, not just repo root — a stray
# `data/` created by running the app from a different working directory must
# stay excluded too, since it can contain real PII (names, RUTs) once the app runs.
**/data/*
!**/data/*.example.csv
!**/data/README.md
*.db

# OpenSpec local workset
openspec/.workset/
publish/
